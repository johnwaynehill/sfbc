<%
/**
 * Meeting details bar partial — time, location, Meetup link
 *
 * Locals:
 *   barMeeting — meeting object (needs: meeting_time, location_text, meetup_event_url)
 */
var _bm = typeof barMeeting !== 'undefined' ? barMeeting : null;
var _hasDetails = _bm && (_bm.meeting_time || _bm.location_text || _bm.meetup_event_url);
-%>
<% if (_hasDetails) { %>
  <div class="meeting-details-bar">
    <% if (_bm.meeting_time) { %>
      <span class="meeting-details-bar__item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <%= formatMeetingTime(_bm.meeting_time) %>
      </span>
    <% } %>
    <% if (_bm.location_text) { %>
      <span class="meeting-details-bar__item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= _bm.location_text %>
      </span>
    <% } %>
    <% if (_bm.meetup_event_url) { %>
      <a href="<%= _bm.meetup_event_url %>" class="meeting-details-bar__item meeting-details-bar__link" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Meetup Event
      </a>
    <% } %>
  </div>
<% } %>
