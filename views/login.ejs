<section class="login-page">
  <% if (step === 'form') { %>
    <% if (typeof invite !== 'undefined' && invite) { %>
      <h1 class="t-section login-page__heading">You&rsquo;re Invited!</h1>
      <p class="t-body text-secondary login-page__subtitle" id="login-subtitle">
        <strong><%= invite.inviterName %></strong> invited you to join the book club. Sign in or create an account to get started.
      </p>
    <% } else { %>
      <h1 class="t-section login-page__heading">Sign In or Create an Account</h1>
      <p class="t-body text-secondary login-page__subtitle" id="login-subtitle">
        Enter your email and we&rsquo;ll send you a login link.
      </p>
    <% } %>

    <% if (error) { %>
      <div class="nom-message nom-message--error" style="margin-bottom: var(--s-3);">
        <%= error %>
      </div>
    <% } %>

    <div id="form-container">
      <form id="login-form" method="POST" action="/auth/send-link" class="login-form">
        <label class="form-label">
          Email
          <input type="email" name="email" required autofocus autocomplete="email"
                 class="form-input" placeholder="you@example.com"
                 value="<%= email || '' %>">
        </label>

        <div id="login-message" role="alert" hidden></div>

        <button type="submit" class="btn btn--primary" id="login-submit" style="width: 100%;">
          Send Login Link
        </button>
      </form>

      <form id="password-form" class="login-form" hidden>
        <label class="form-label">
          Email
          <input type="email" name="pw_email" required autocomplete="email"
                 class="form-input" placeholder="you@example.com">
        </label>
        <label class="form-label">
          Password
          <div class="password-wrapper">
            <input type="password" name="pw_password" required autocomplete="current-password"
                   class="form-input" placeholder="Your password">
            <button type="button" class="password-toggle" aria-label="Show password">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line class="pw-slash" x1="2" y1="2" x2="22" y2="22"/></svg>
            </button>
          </div>
        </label>
        <div id="pw-message" role="alert" hidden></div>
        <button type="submit" class="btn btn--primary" id="pw-submit" style="width: 100%;">
          Sign In with Password
        </button>
      </form>
    </div>

    <div class="login-divider">
      <span class="login-divider__text t-caption text-tertiary">or</span>
    </div>

    <button type="button" class="btn-quiet" id="toggle-pw" style="width: 100%; justify-content: center;">
      Use password instead
    </button>

  <% } else if (step === 'sent') { %>
    <div class="login-sent">
      <h1 class="t-section login-page__heading">Check Your Email</h1>
      <p class="t-body">
        We sent a login link to <strong><%= email %></strong>.
      </p>
      <p class="t-body text-secondary">
        Click the link in the email to sign in. It expires in 15 minutes.
      </p>
      <p class="t-caption text-secondary" style="margin-top: var(--s-4);">
        Didn't receive it? Check your spam folder or
        <a href="/login">try again</a>.
      </p>
    </div>

  <% } else if (step === 'error') { %>
    <div class="login-sent">
      <h1 class="t-section login-page__heading"><%= pageTitle %></h1>
      <div class="nom-message nom-message--error" style="margin-bottom: var(--s-4);">
        <%= error %>
      </div>
      <a href="/login" class="btn btn--primary">Try Again</a>
    </div>
  <% } %>
</section>

<script>
(function () {
  'use strict';

  var magicForm = document.getElementById('login-form');
  if (!magicForm) return;

  var pwForm = document.getElementById('password-form');
  var toggleBtn = document.getElementById('toggle-pw');
  var subtitle = document.getElementById('login-subtitle');
  var submitBtn = document.getElementById('login-submit');
  var messageEl = document.getElementById('login-message');
  var showingPassword = false;

  // ---- Form swap toggle ----
  if (toggleBtn && pwForm) {
    toggleBtn.addEventListener('click', function () {
      showingPassword = !showingPassword;
      if (showingPassword) {
        magicForm.hidden = true;
        pwForm.hidden = false;
        toggleBtn.textContent = 'Use magic link instead';
        subtitle.textContent = 'Enter your email and a password to sign in or create an account.';
        // Copy email across if filled
        var magicEmail = magicForm.querySelector('[name="email"]').value;
        if (magicEmail) pwForm.querySelector('[name="pw_email"]').value = magicEmail;
        pwForm.querySelector('[name="pw_email"]').focus();
      } else {
        pwForm.hidden = true;
        magicForm.hidden = false;
        toggleBtn.textContent = 'Use password instead';
        subtitle.textContent = 'Enter your email and we\u2019ll send you a login link.';
        // Copy email back
        var pwEmail = pwForm.querySelector('[name="pw_email"]').value;
        if (pwEmail) magicForm.querySelector('[name="email"]').value = pwEmail;
        magicForm.querySelector('[name="email"]').focus();
      }
    });
  }

  // ---- Magic link form ----
  magicForm.addEventListener('submit', async function (e) {
    e.preventDefault();

    var email = magicForm.querySelector('[name="email"]').value.trim();
    if (!email) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending\u2026';

    try {
      var res = await fetch('/auth/send-link', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({ email: email }),
      });

      var data = await res.json();

      if (res.ok && data.success) {
        // Replace entire form area with success message
        var container = document.getElementById('form-container');
        container.innerHTML =
          '<div class="login-sent">' +
          '<h2 class="t-section" style="margin-bottom: var(--s-3);">Check Your Email</h2>' +
          '<p class="t-body">We sent a login link to <strong>' + email + '</strong>.</p>' +
          '<p class="t-body text-secondary">Click the link in the email to sign in. It expires in 15 minutes.</p>' +
          '<p class="t-caption text-secondary" style="margin-top: var(--s-4);">' +
          'Didn\'t receive it? Check your spam folder or <a href="/login">try again</a>.</p>' +
          '</div>';
        // Hide divider and toggle
        var divider = document.querySelector('.login-divider');
        if (divider) divider.style.display = 'none';
        if (toggleBtn) toggleBtn.style.display = 'none';
        if (subtitle) subtitle.style.display = 'none';
        return;
      }

      messageEl.hidden = false;
      messageEl.className = 'nom-message nom-message--error';
      messageEl.textContent = data.error || 'Something went wrong.';
    } catch (err) {
      messageEl.hidden = false;
      messageEl.className = 'nom-message nom-message--error';
      messageEl.textContent = 'Network error. Please try again.';
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Send Login Link';
  });

  // ---- Password form ----
  if (pwForm) {
    pwForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var pwEmail = pwForm.querySelector('[name="pw_email"]').value.trim();
      var pwPass = pwForm.querySelector('[name="pw_password"]').value;
      var pwSubmit = document.getElementById('pw-submit');
      var pwMsg = document.getElementById('pw-message');

      if (!pwEmail || !pwPass) return;

      pwSubmit.disabled = true;
      pwSubmit.textContent = 'Signing in\u2026';

      try {
        var res = await fetch('/auth/password-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ email: pwEmail, password: pwPass }),
        });
        var data = await res.json();

        if (res.ok && data.success) {
          window.location.href = data.redirect || '/';
          return;
        }

        pwMsg.hidden = false;
        pwMsg.className = 'nom-message nom-message--error';
        pwMsg.textContent = data.error || 'Something went wrong.';
      } catch (err) {
        pwMsg.hidden = false;
        pwMsg.className = 'nom-message nom-message--error';
        pwMsg.textContent = 'Network error. Please try again.';
      }

      pwSubmit.disabled = false;
      pwSubmit.textContent = 'Sign In with Password';
    });
  }
  // ---- Password visibility toggle ----
  document.querySelectorAll('.password-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.parentElement.querySelector('input');
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.classList.toggle('is-visible', show);
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
  });
})();
</script>
