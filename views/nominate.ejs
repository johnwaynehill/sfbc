<section class="nom-page">
  <h1 class="t-section nom-page__heading"><%= pageTitle %></h1>
  <p class="t-body text-secondary nom-page__subheading">for <%= formatMonthYear(meeting.month_year) %></p>
  <% if (user) { %>
    <p class="t-caption text-secondary" style="margin-bottom: var(--s-3);">Nominating as <strong><%= user.display_name %></strong></p>
  <% } %>

  <% if (alreadyNominated) { %>
    <div class="nom-confirmed">
      <p class="nom-confirmed__badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        Nomination Submitted
      </p>

      <div class="nom-confirmed__card">
        <% if (existingNomination.cover_url) { %>
          <div class="book-cover book-cover--sm">
            <img src="<%= existingNomination.cover_url %>" alt="Cover of <%= existingNomination.title %>">
          </div>
        <% } %>
        <div class="nom-confirmed__details">
          <span class="nom-confirmed__title"><%= existingNomination.title %></span>
          <span class="nom-confirmed__author">by <%= existingNomination.author %></span>
          <% if (existingNomination.reason) { %>
            <p class="nom-confirmed__reason">&ldquo;<%= existingNomination.reason %>&rdquo;</p>
          <% } %>
        </div>
      </div>

      <div class="nom-confirmed__actions">
        <a href="/nominations/<%= meetingSlug %>" class="btn btn--primary">View Nominations</a>
        <a href="/nominate/<%= meetingSlug %>?edit=1" class="btn btn--secondary">Edit Nomination</a>
      </div>
    </div>
  <% } else { %>
    <div id="nom-message" hidden></div>

    <form id="nom-form"
          class="nom-form"
          method="POST"
          action="/api/meetings/<%= meeting.id %>/nominations"
          data-meeting-id="<%= meeting.id %>"
          data-meeting-slug="<%= meetingSlug %>">

      <div class="nom-form__fields">
        <div class="form-group">
          <label class="form-label" for="nom-title">Book Title <span class="form-required">*</span></label>
          <input type="text"
                 name="title"
                 id="nom-title"
                 required
                 autocomplete="off"
                 class="form-input"
                 placeholder="e.g. The Left Hand of Darkness"
                 value="<%= editMode && existingNomination ? existingNomination.title : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="nom-author">Author <span class="form-required">*</span></label>
          <input type="text"
                 name="author"
                 id="nom-author"
                 required
                 autocomplete="off"
                 class="form-input"
                 placeholder="e.g. Ursula K. Le Guin"
                 value="<%= editMode && existingNomination ? existingNomination.author : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="nom-reason">Why this book? <span class="form-hint">(optional, 280 chars)</span></label>
          <textarea name="reason"
                    id="nom-reason"
                    maxlength="280"
                    rows="2"
                    class="form-input"
                    placeholder="A quick pitch for why the club should read this&hellip;"><%= editMode && existingNomination && existingNomination.reason ? existingNomination.reason : '' %></textarea>
          <span class="char-counter" id="reason-counter">0 / 280</span>
        </div>
      </div>

      <!-- Live cover preview (populated by JS, tappable to fill form) -->
      <button type="button" id="cover-preview" class="nom-preview" hidden aria-label="Use this book's details">
        <div class="book-cover book-cover--sm">
          <img id="preview-img" src="" alt="Cover preview">
        </div>
        <div class="nom-preview__info">
          <span id="preview-title" class="nom-preview__title"></span>
          <span id="preview-author" class="nom-preview__author"></span>
          <span id="preview-year" class="nom-preview__year"></span>
          <span class="nom-preview__hint t-caption">Tap to use these details</span>
        </div>
      </button>

      <button type="submit" class="btn btn--primary" id="nom-submit"><%= editMode ? 'Update Nomination' : 'Submit Nomination' %></button>
    </form>
  <% } %>
</section>
