<section class="results-page">
  <header class="results-page__header">
    <h1 class="t-section results-page__heading"><%= pageTitle %></h1>
    <p class="t-body text-secondary">for <%= formatMonthYear(meeting.month_year) %></p>
    <div class="results-page__meta">
      <span class="status-pill status-pill--<%= isVotingOpen ? 'open' : 'closed' %>">
        <%= isVotingOpen ? 'Voting Open' : 'Voting Closed' %>
      </span>
      <span class="t-caption text-secondary">
        <span id="results-vote-count"><%= results.voteCount %></span> vote<%= results.voteCount === 1 ? '' : 's' %>
      </span>
    </div>
  </header>

  <%- include('partials/meeting-details-bar', { barMeeting: barMeeting }) %>

  <% if (winner) { %>
    <div class="results-winner" data-winner-cover="<%= winner.cover_url || '' %>" data-winner-title="<%= winner.title %>">
      <div class="results-winner__ribbon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Winner
      </div>
      <div class="results-winner__card">
        <a href="<%= bookPath(winner.title, winner.author) %>" class="results-winner__cover">
          <% if (winner.cover_url) { %>
            <img src="<%= winner.cover_url %>" alt="<%= winner.title %> cover" class="results-winner__cover-img">
          <% } else { %>
            <%- include('partials/placeholder-cover', { phTitle: winner.title }) %>
          <% } %>
        </a>
        <div class="results-winner__info">
          <span class="results-winner__title"><%= winner.title %></span>
          <span class="results-winner__author"><%= winner.author %></span>
          <% if (winner.nominator_name) { %>
            <span class="results-winner__nominator">Nominated by <%= winner.nominator_name %></span>
          <% } %>
          <a href="<%= bookPath(winner.title, winner.author) %>" class="btn btn--primary btn--sm results-winner__link">
            View Book &rarr;
          </a>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Horizontal bar chart -->
  <div class="results-chart" id="results-chart">
    <% results.rankings.forEach(function(r) {
         var subjectList = [];
         if (r.subjects) {
           try { subjectList = JSON.parse(r.subjects); } catch (e) { subjectList = []; }
         }
    %>
      <button type="button" class="results-bar js-results-detail" data-book-id="<%= r.book_id %>">
        <div class="book-cover book-cover--xs results-bar__cover">
          <% if (r.cover_url) { %>
            <img src="<%= r.cover_url %>" alt="<%= r.title %> cover" loading="lazy">
          <% } else { %>
            <%- include('partials/placeholder-cover', { phTitle: r.title, phSize: 'xs' }) %>
          <% } %>
        </div>
        <div class="results-bar__info">
          <div class="results-bar__meta">
            <span class="results-bar__title t-caption-bold"><%= r.title %></span>
            <% if (r.nominator_name) { %>
              <span class="results-bar__nominator t-caption text-tertiary">nominated by <%= r.nominator_name %></span>
            <% } %>
          </div>
          <span class="results-bar__author t-caption text-secondary"><%= r.author %></span>
          <div class="results-bar__track">
            <div class="results-bar__fill"
                 style="width: <%= r.pct %>%; background-color: <%= colors[r.book_id] %>;"
                 data-pct="<%= r.pct %>"></div>
          </div>
        </div>
        <span class="results-bar__points t-caption" data-points="<%= r.points %>">
          <%= r.points %> pt<%= r.points === 1 ? '' : 's' %>
        </span>
        <template class="results-bar__details-template">
          <div class="book-details">
            <div class="book-details__header">
              <div class="book-cover book-cover--md book-details__cover">
                <% if (r.cover_url) { %>
                  <img src="<%= r.cover_url %>" alt="<%= r.title %> cover" loading="lazy">
                <% } else { %>
                  <%- include('partials/placeholder-cover', { phTitle: r.title, phSize: 'md' }) %>
                <% } %>
              </div>
              <div class="book-details__meta">
                <h2 class="book-details__title t-display"><%= r.title %></h2>
                <p class="book-details__author t-author">by <%= r.author %></p>
                <% var metaParts = []; %>
                <% if (r.publication_year) metaParts.push(r.publication_year); %>
                <% if (r.page_count) metaParts.push(r.page_count + ' pages'); %>
                <% if (r.publisher) metaParts.push(r.publisher); %>
                <% if (r.language && r.language !== 'en') metaParts.push(r.language.toUpperCase()); %>
                <% if (metaParts.length > 0) { %>
                  <p class="book-details__inline-meta t-caption text-secondary"><%= metaParts.join(' · ') %></p>
                <% } %>
                <% if (subjectList.length > 0) { %>
                  <div class="book-details__tags">
                    <% subjectList.slice(0, 4).forEach(function(tag) { %>
                      <span class="book-tag"><%= tag %></span>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </div>
            <% if (r.description) { %>
              <div class="book-details__section">
                <p class="book-details__description t-body"><%= r.description %></p>
              </div>
            <% } %>
            <% if (r.reason || r.nominator_name) { %>
              <div class="book-details__section book-details__nomination">
                <% if (r.nominator_name) { %>
                  <p class="t-label">Nominated by <%= r.nominator_name %></p>
                <% } %>
                <% if (r.reason) { %>
                  <p class="book-details__reason t-body">&ldquo;<%= r.reason %>&rdquo;</p>
                <% } %>
              </div>
            <% } %>
            <div class="book-details__footer">
              <a href="/books/<%= r.author_slug %>/<%= r.title_slug %>"
                 class="book-details__link">
                View Details
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
        </template>
      </button>
    <% }); %>
  </div>

  <% if (isVotingOpen) { %>
    <p class="t-caption text-tertiary results-page__updated" id="results-last-updated">
      Last updated just now
    </p>
  <% } %>

  <dialog id="book-details-dialog" class="book-details-dialog" aria-labelledby="book-details-dialog-title">
    <button type="button" class="book-details-dialog__close" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="book-details-dialog__body" id="book-details-dialog-body"></div>
  </dialog>
</section>

<script>
(function () {
  'use strict';
  var dialog = document.getElementById('book-details-dialog');
  var body   = document.getElementById('book-details-dialog-body');
  if (!dialog || !body) return;

  function openDialog(btn) {
    var template = btn.querySelector('.results-bar__details-template');
    if (!template) return;
    body.innerHTML = '';
    body.appendChild(template.content.cloneNode(true));
    if (typeof dialog.showModal === 'function') {
      dialog.showModal();
    } else {
      dialog.setAttribute('open', '');
    }
    document.body.classList.add('has-open-dialog');
  }

  function closeDialog() {
    dialog.classList.add('is-closing');
    setTimeout(function () {
      dialog.classList.remove('is-closing');
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
      body.innerHTML = '';
      document.body.classList.remove('has-open-dialog');
    }, 180);
  }

  document.getElementById('results-chart').addEventListener('click', function (e) {
    var btn = e.target.closest('.js-results-detail');
    if (btn) openDialog(btn);
  });

  dialog.addEventListener('click', function (e) {
    if (e.target === dialog) closeDialog();
  });
  dialog.addEventListener('cancel', function (e) {
    e.preventDefault();
    closeDialog();
  });
  var closeBtn = dialog.querySelector('.book-details-dialog__close');
  if (closeBtn) closeBtn.addEventListener('click', closeDialog);
})();
</script>

<script>
  // Config for SSE client
  window.__RESULTS_CONFIG__ = {
    meetingId: <%= meeting.id %>,
    isVotingOpen: <%= isVotingOpen ? 'true' : 'false' %>,
    colors: <%- JSON.stringify(colors) %>,
  };
</script>
<% if (winner) { %>
<script src="/js/winner-reveal.js?v=2" defer></script>
<% } %>
