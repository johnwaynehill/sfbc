<!-- ===== Book Hero ===== -->
<section class="book-hero">
  <div class="book-cover book-cover--lg">
    <% const coverUrl = getCoverUrl(book); %>
    <% if (coverUrl) { %>
      <img src="<%= coverUrl %>" alt="Cover of <%= book.title %>">
    <% } else { %>
      <div class="placeholder-cover">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
        </svg>
      </div>
    <% } %>
  </div>

  <div class="book-hero__body">
    <% if (book.month_year) { %>
      <span class="t-label text-tertiary"><%= formatMonthYear(book.month_year) %></span>
    <% } %>
    <h1 class="t-display book-hero__title"><%= book.title %></h1>
    <p class="t-author"><%= book.author %></p>

    <% if (typeof subjects !== 'undefined' && subjects.length > 0) { %>
      <div class="book-hero__tags">
        <% subjects.slice(0, 6).forEach(function(tag) { %>
          <span class="book-tag"><%= tag %></span>
        <% }); %>
      </div>
    <% } %>

    <% if (avgGrade) { %>
      <div class="book-hero__grade">
        <span class="grade-badge <%= gradeTier(avgGrade) %>"><%= avgGrade %></span>
        <span class="t-body text-secondary"><%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %></span>
      </div>
    <% } %>

    <% if (book.description) { %>
      <div class="book-description">
        <p class="book-description__text" id="book-desc-text"><%= book.description %></p>
        <% if (book.description.length > 200) { %>
          <button class="book-description__toggle" id="book-desc-toggle">Read more</button>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<!-- ===== Metadata ===== -->
<section class="section" style="padding-top: 0;">
  <dl class="metadata-list">
    <% if (book.publication_year) { %>
      <dt>Published</dt>
      <dd><%= book.publication_year %></dd>
    <% } %>
    <% if (book.page_count) { %>
      <dt>Pages</dt>
      <dd><%= book.page_count %></dd>
    <% } %>
    <dt>Goodreads</dt>
    <dd><a href="https://www.goodreads.com/search?q=<%= encodeURIComponent(book.title + ' ' + book.author) %>" target="_blank" rel="noopener">Search on Goodreads</a></dd>
    <dt>StoryGraph</dt>
    <dd><a href="https://app.thestorygraph.com/browse?search_term=<%= encodeURIComponent(book.title + ' ' + book.author) %>" target="_blank" rel="noopener">Search on StoryGraph</a></dd>
    <dt>Google Books</dt>
    <% if (book.google_books_id) { %>
      <dd><a href="https://books.google.com/books?id=<%= book.google_books_id %>" target="_blank" rel="noopener">View on Google Books</a></dd>
    <% } else { %>
      <dd><a href="https://www.google.com/search?tbm=bks&q=<%= encodeURIComponent(book.title + ' ' + book.author) %>" target="_blank" rel="noopener">Search on Google Books</a></dd>
    <% } %>
    <% if (book.meetup_event_url) { %>
      <dt>Meetup</dt>
      <dd><a href="<%= book.meetup_event_url %>" target="_blank" rel="noopener">View Event</a></dd>
    <% } %>
  </dl>
</section>

<!-- ===== Grade Distribution ===== -->
<% if (gradeDistribution.length > 0) { %>
<%
  // Collect which tier letters have at least one review
  const activeTiers = new Set(gradeDistribution.map(r => r.grade.charAt(0).toUpperCase()));
  const totalReviews = gradeDistribution.reduce((s, r) => s + r.count, 0);
%>
<section class="section">
  <div class="grade-dist">
    <div class="grade-dist__header">
      <span class="grade-dist__title">Grade Distribution</span>
      <div class="grade-dist__right">
        <% if (avgGrade) { %>
          <span class="grade-dist__avg-badge grade-dist__avg-badge--<%= avgGrade.charAt(0).toLowerCase() %>"><%= avgGrade %></span>
        <% } %>
        <span class="grade-dist__count"><%= totalReviews %> review<%= totalReviews !== 1 ? 's' : '' %></span>
      </div>
    </div>
    <div class="grade-dist__strip-wrap">
      <div class="grade-dist__strip" style="background: <%= gradeGradient %>;"></div>
      <% if (avgGradePercent != null) { %>
        <div class="grade-dist__tick" style="left: <%= avgGradePercent %>%;"></div>
      <% } %>
    </div>
    <div class="grade-dist__axis">
      <span<%= activeTiers.has('F') ? ' class="active"' : '' %>>F</span>
      <span<%= activeTiers.has('D') ? ' class="active"' : '' %>>D</span>
      <span<%= activeTiers.has('C') ? ' class="active"' : '' %>>C</span>
      <span<%= activeTiers.has('B') ? ' class="active"' : '' %>>B</span>
      <span<%= activeTiers.has('A') ? ' class="active"' : '' %>>A</span>
      <span<%= activeTiers.has('S') ? ' class="active"' : '' %>>S</span>
    </div>
  </div>
</section>
<% } %>

<!-- ===== Reviews ===== -->
<% const spoilerCount = reviews.filter(r => r.has_spoilers).length; %>
<section class="section">
  <div class="reviews-header">
    <h2 class="t-section">Reviews</h2>
    <div class="reviews-header__actions">
      <% if (spoilerCount > 0) { %>
        <button type="button" class="spoiler-toggle" id="spoilerToggle"
                aria-pressed="false"
                aria-label="Show spoiler reviews">
          <svg class="spoiler-toggle__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
          </svg>
          <span class="spoiler-toggle__label" id="spoilerToggleLabel">Show <%= spoilerCount %> spoiler<%= spoilerCount !== 1 ? 's' : '' %></span>
        </button>
      <% } %>
      <% if (reviews.length > 1) { %>
        <div class="sort-dropdown" id="reviewSortDropdown">
          <button type="button" class="history-btn" id="reviewSortBtn" aria-label="Sort reviews" aria-haspopup="listbox" aria-expanded="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M3 12h12"/><path d="M3 18h6"/></svg>
          </button>
          <ul class="sort-dropdown__menu" id="reviewSortMenu" role="listbox" aria-label="Sort order">
            <li class="sort-dropdown__item is-selected" role="option" data-sort="newest" aria-selected="true">Newest first</li>
            <li class="sort-dropdown__item" role="option" data-sort="oldest" aria-selected="false">Oldest first</li>
            <li class="sort-dropdown__item" role="option" data-sort="highest" aria-selected="false">Highest grade</li>
            <li class="sort-dropdown__item" role="option" data-sort="lowest" aria-selected="false">Lowest grade</li>
          </ul>
        </div>
      <% } %>
      <% if (user && userReview) { %>
        <a href="/books/<%= book.author_slug %>/<%= book.title_slug %>/review" class="btn btn--ghost btn--sm">Edit My Review</a>
      <% } else if (user) { %>
        <a href="/books/<%= book.author_slug %>/<%= book.title_slug %>/review" class="btn btn--primary btn--sm">Write a Review</a>
      <% } %>
    </div>
  </div>

  <% if (reviews.length > 0) { %>
  <div class="review-list" id="reviewList" data-spoiler-count="<%= spoilerCount %>">
    <% for (const review of reviews) { %>
      <div class="review-card<%= review.has_spoilers ? ' review-card--spoiler' : '' %>" data-review-id="<%= review.id %>" data-date="<%= review.created_at %>" data-weight="<%= review.weight %>"<%- review.has_spoilers ? ' data-spoiler="true"' : '' %>>
        <div class="review-card__grade-col">
          <span class="grade-badge grade-badge--sm <%= gradeTier(review.grade) %>"><%= review.grade %></span>
          <% if (review.has_spoilers) { %>
            <span class="spoiler-badge">Spoiler</span>
          <% } %>
        </div>
        <div class="review-card__body">
          <div class="review-card__meta">
            <% if (user && review.display_name) { %>
              <% if (review.user_slug) { %>
                <a href="/members/<%= review.user_slug %>" class="review-card__reviewer">
                  <%- include('partials/avatar', { avatarUser: review, avatarSize: 'sm', avatarClass: '' }) %>
                  <span class="review-card__author"><%= review.display_name %></span>
                </a>
              <% } else { %>
                <span class="review-card__reviewer">
                  <%- include('partials/avatar', { avatarUser: review, avatarSize: 'sm', avatarClass: '' }) %>
                  <span class="review-card__author"><%= review.display_name %></span>
                </span>
              <% } %>
            <% } else if (!user) { %>
              <span class="review-card__author" style="font-style: italic; opacity: 0.7;">Anonymous</span>
            <% } %>
            <span class="review-card__date">
              <%= new Date(review.created_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %><% if (review.updated_at && review.updated_at !== review.created_at) { %><span class="review-card__edited" title="Edited <%= new Date(review.updated_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>">&nbsp;(edited)</span><% } %>
            </span>
          </div>
          <% if (review.body_markdown) { %>
            <div class="review-card__text"><%- renderMarkdown(review.body_markdown) %></div>
          <% } %>
          <% if (user && user.id === review.user_id) { %>
            <button type="button" class="review-card__delete" data-book-id="<%= book.id %>" aria-label="Delete my review">Delete</button>
          <% } %>

          <!-- Emoji reactions -->
          <div class="reaction-bar" data-review-id="<%= review.id %>">
            <% const reviewReactions = reactionCounts.get(review.id) || []; %>
            <% const myReactions = userReactions.get(review.id) || new Set(); %>
            <% for (const r of reviewReactions) { %>
              <button type="button"
                class="reaction-pill<%= myReactions.has(r.emoji) ? ' is-active' : '' %>"
                data-emoji="<%= r.emoji %>"
                <%= user ? '' : 'disabled' %>
                aria-label="<%= r.emoji %> (<%= r.count %>)">
                <span class="reaction-pill__emoji"><%= r.emoji %></span>
                <span class="reaction-pill__count"><%= r.count %></span>
              </button>
            <% } %>
            <% if (user) { %>
              <button type="button" class="reaction-add" aria-label="Add reaction">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            <% } %>
          </div>

          <!-- Replies -->
          <% const reviewReplies = repliesMap.get(review.id) || []; %>
          <div class="reply-section" data-review-id="<%= review.id %>">
            <% if (reviewReplies.length > 0) { %>
              <div class="reply-list">
                <% for (const reply of reviewReplies) { %>
                  <div class="reply" data-reply-id="<%= reply.id %>" data-user-id="<%= reply.user_id %>">
                    <div class="reply__meta">
                      <% if (user && reply.user_slug) { %>
                        <a href="/members/<%= reply.user_slug %>" class="reply__author-link">
                          <%- include('partials/avatar', { avatarUser: reply, avatarSize: 'sm', avatarClass: '' }) %>
                          <span class="reply__author"><%= reply.display_name %></span>
                        </a>
                      <% } else { %>
                        <span class="reply__author-link">
                          <%- include('partials/avatar', { avatarUser: reply, avatarSize: 'sm', avatarClass: '' }) %>
                          <span class="reply__author"><%= reply.display_name || 'Anonymous' %></span>
                        </span>
                      <% } %>
                      <span class="reply__date"><%= new Date(reply.created_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %><% if (reply.updated_at && reply.updated_at !== reply.created_at) { %><span class="reply__edited">&nbsp;(edited)</span><% } %></span>
                    </div>
                    <div class="reply__body"><%- renderMarkdown(reply.body_markdown) %></div>
                    <% if (user && user.id === reply.user_id) { %>
                      <div class="reply__actions">
                        <button type="button" class="reply__edit-btn" data-reply-id="<%= reply.id %>">Edit</button>
                        <button type="button" class="reply__delete-btn" data-reply-id="<%= reply.id %>">Delete</button>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>
            <% } %>
            <% if (user) { %>
              <button type="button" class="reply-trigger" data-review-id="<%= review.id %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Reply<% if (reviewReplies.length > 0) { %> (<%= reviewReplies.length %>)<% } %>
              </button>
              <div class="reply-form-wrap" data-review-id="<%= review.id %>" hidden>
                <textarea class="reply-form__textarea" placeholder="Write a reply…" maxlength="2000" rows="3"></textarea>
                <div class="reply-form__footer">
                  <span class="reply-form__char-count">0 / 2,000</span>
                  <div class="reply-form__btns">
                    <button type="button" class="btn btn--ghost btn--xs reply-form__cancel">Cancel</button>
                    <button type="button" class="btn btn--primary btn--xs reply-form__submit">Reply</button>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
  <% } else { %>
  <div class="empty-state">
    <p class="empty-state__message">No reviews yet.</p>
  </div>
  <% } %>
</section>

<% if (book.description && book.description.length > 200) { %>
<script>
(function () {
  'use strict';
  var text = document.getElementById('book-desc-text');
  var toggle = document.getElementById('book-desc-toggle');
  if (!text || !toggle) return;

  toggle.addEventListener('click', function () {
    var expanded = text.classList.toggle('is-expanded');
    toggle.textContent = expanded ? 'Show less' : 'Read more';
  });
})();
</script>
<% } %>

