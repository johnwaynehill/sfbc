<section class="members-page">
  <div class="members-page__header">
    <div>
      <h1 class="t-section">Members</h1>
      <span class="t-body text-secondary"><%= members.length %> member<%= members.length !== 1 ? 's' : '' %></span>
    </div>
    <button type="button" class="btn btn--secondary btn--sm" id="invite-btn">Invite a Friend</button>
  </div>

  <% if (members.length > 5) { %>
    <div class="members-search">
      <svg class="members-search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="text" id="memberSearchInput" class="members-search__input" placeholder="Search members…" autocomplete="off">
    </div>
  <% } %>

  <div class="members-grid" id="membersGrid">
    <% for (const m of members) { %>
      <a href="/members/<%= m.username || m.user_slug %>" class="member-card" data-name="<%= (m.display_name || '').toLowerCase() %>">
        <%- include('partials/avatar', { avatarUser: m, avatarSize: 'md', avatarClass: '' }) %>
        <div class="member-card__info">
          <span class="member-card__name t-body-bold"><%= m.display_name %></span>
          <span class="member-card__meta t-caption text-secondary">
            <%= m.review_count %> review<%= m.review_count !== 1 ? 's' : '' %>
            &middot;
            Joined <%= new Date(m.created_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) %>
          </span>
        </div>
      </a>
    <% } %>
  </div>

  <div id="noMembers" class="admin-empty" role="status" aria-live="polite" hidden>
    <p class="t-body text-secondary">No members match your search.</p>
  </div>
</section>

<script>
(function () {
  'use strict';
  var input = document.getElementById('memberSearchInput');
  var grid = document.getElementById('membersGrid');
  var noResults = document.getElementById('noMembers');
  if (input && grid) {
    input.addEventListener('input', function () {
      var query = input.value.trim().toLowerCase();
      var cards = grid.querySelectorAll('.member-card');
      var visible = 0;
      cards.forEach(function (card) {
        var name = card.getAttribute('data-name') || '';
        var match = !query || name.indexOf(query) !== -1;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (noResults) noResults.hidden = visible > 0 || !query;
    });
  }

  // Invite a Friend
  var inviteBtn = document.getElementById('invite-btn');
  if (inviteBtn) {
    inviteBtn.addEventListener('click', async function () {
      inviteBtn.disabled = true;
      inviteBtn.textContent = 'Creating link\u2026';
      try {
        var res = await fetch('/api/invites', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        });
        var data = await res.json();
        if (data.success && data.url) {
          if (navigator.share) {
            await navigator.share({
              title: 'Join our Book Club!',
              text: 'You\u2019re invited to join the SF Book Club.',
              url: data.url,
            });
          } else {
            await navigator.clipboard.writeText(data.url);
            showAlert('Invite link copied to clipboard!');
          }
        } else {
          showAlert(data.error || 'Could not create invite.');
        }
      } catch (err) {
        if (err.name !== 'AbortError') {
          showAlert('Something went wrong.');
        }
      }
      inviteBtn.disabled = false;
      inviteBtn.textContent = 'Invite a Friend';
    });
  }
})();
</script>
