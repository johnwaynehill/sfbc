<!-- ===== Hero ===== -->
<section class="lp-hero">
  <div class="lp-hero__content">
    <p class="lp-hero__eyebrow">GatherBound</p>
    <h1 class="lp-hero__title">Your book club is more than a&nbsp;meeting.<br>Give it a&nbsp;home.</h1>
    <p class="lp-hero__subtitle">Give every member a place to nominate, vote, review, and discuss, whether or not they made it to the meeting.</p>
    <div class="lp-hero__actions">
      <a href="#waitlist" class="lp-hero__cta">Join the waitlist</a>
      <a href="/" class="lp-hero__cta lp-hero__cta--ghost">See a live club&nbsp;&rarr;</a>
    </div>
    <p class="lp-hero__trust">
      Built to run our own club: the <strong>SF Fantasy &amp; Sci-Fi Book Club</strong>.
      1,083 members &middot; 800+ RSVPs &middot; meeting monthly since 2023.
    </p>
  </div>
  <% if (recentBooks && recentBooks.length > 0) { %>
  <div class="lp-hero__covers" aria-hidden="true">
    <% for (const book of recentBooks) { %>
    <div class="lp-hero__cover">
      <% if (book.cover_url) { %>
      <img src="<%= book.cover_url %>" alt="" loading="eager">
      <% } %>
    </div>
    <% } %>
  </div>
  <% } %>
</section>

<!-- ===== Manifesto (the problem) ===== -->
<section class="lp-manifesto reveal">
  <div class="page-container">
    <h2 class="lp-manifesto__quote">The community is always bigger than the room.</h2>
    <p class="lp-manifesto__lead">Your meeting seats twenty-five. Your club is hundreds. Most of the people who joined because they love books will never get a seat, and today, showing up is the only way to take part.</p>
    <div class="lp-manifesto__body">
      <div class="lp-manifesto__problems">
        <div class="lp-manifesto__problem">
          <strong>Meetup</strong> gets people in the door, then provides zero engagement between events.
        </div>
        <div class="lp-manifesto__problem">
          <strong>Discord</strong> is ephemeral and overwhelming. A discussion about Chapter 3 disappears in a flood of memes.
        </div>
        <div class="lp-manifesto__problem">
          <strong>Goodreads</strong> is a personal tracker. But your club's history gets lost to time and memory.
        </div>
      </div>
      <div class="lp-manifesto__resolution">
        <p class="lp-manifesto__turn">So clubs duct-tape multiple tools together. None are really built for everything a book club needs. None of them provide a living history or work for people who can't make the meeting.</p>
        <p class="lp-manifesto__turn lp-manifesto__turn--punch"><strong>GatherBound is the first one that solves needs and creates a lasting archive of your club.</strong></p>
      </div>
    </div>
  </div>
</section>

<!-- ===== Showcase (Peek inside a real club) ===== -->
<% if (showcase) { %>
<section class="lp-showcase">
  <div class="page-container">
    <p class="lp-showcase__eyebrow reveal">Take a peek inside</p>
    <h2 class="lp-showcase__heading reveal">This isn't a mockup. It's a real club, running right now.</h2>
    <p class="lp-showcase__sub reveal">We built GatherBound to run our own club. Everything below is live: real books, real grades, real members. Click in and look around.</p>

    <div class="lp-showcase__grid">
      <!-- Preview 1: the club home -->
      <a class="lp-frame reveal" href="/">
        <div class="lp-frame__bar" aria-hidden="true">
          <span class="lp-frame__dot"></span><span class="lp-frame__dot"></span><span class="lp-frame__dot"></span>
          <span class="lp-frame__url">gatherbound.club</span>
        </div>
        <div class="lp-frame__body">
          <p class="lp-frame__caption">The club's home page</p>
          <div class="lp-preview-hero">
            <div class="lp-preview-hero__cover">
              <img src="<%= showcase.home.cover_url %>" alt="" loading="lazy">
            </div>
            <div class="lp-preview-hero__meta">
              <span class="lp-preview-pill"><%= showcase.home.label %></span>
              <span class="lp-preview-hero__title"><%= showcase.home.title %></span>
              <span class="lp-preview-hero__author">by <%= showcase.home.author %></span>
            </div>
          </div>
          <p class="lp-preview-label">Recent reads</p>
          <div class="lp-preview-strip">
            <% for (const c of showcase.home.recentCovers) { %>
            <div class="lp-preview-strip__cover"><img src="<%= c.cover_url %>" alt="" loading="lazy"></div>
            <% } %>
          </div>
        </div>
      </a>

      <!-- Preview 2: a book's archive page -->
      <a class="lp-frame reveal" href="<%= showcase.archive.href %>">
        <div class="lp-frame__bar" aria-hidden="true">
          <span class="lp-frame__dot"></span><span class="lp-frame__dot"></span><span class="lp-frame__dot"></span>
          <span class="lp-frame__url">gatherbound.club<%= showcase.archive.href %></span>
        </div>
        <div class="lp-frame__body">
          <p class="lp-frame__caption">Every book becomes an archive</p>
          <div class="lp-preview-book">
            <div class="lp-preview-book__cover">
              <img src="<%= showcase.archive.cover_url %>" alt="" loading="lazy">
            </div>
            <div class="lp-preview-book__meta">
              <span class="lp-preview-book__title"><%= showcase.archive.title %></span>
              <% if (showcase.archive.avgGrade) { %>
              <div class="lp-preview-grade">
                <span class="lp-preview-grade__badge"><%= showcase.archive.avgGrade %></span>
                <span class="lp-preview-grade__label">Club average<br>from <%= showcase.archive.reviewCount %> review<%= showcase.archive.reviewCount === 1 ? '' : 's' %></span>
              </div>
              <% } %>
            </div>
          </div>
          <% if (showcase.archive.reviewText) { %>
          <blockquote class="lp-preview-review">
            <p class="lp-preview-review__text">&ldquo;<%= showcase.archive.reviewText %>&rdquo;</p>
            <p class="lp-preview-review__by">
              <% if (showcase.archive.reviewGrade) { %><span class="lp-preview-review__grade"><%= showcase.archive.reviewGrade %></span><% } %>
              <%= showcase.archive.reviewer %>
            </p>
          </blockquote>
          <% } %>
        </div>
      </a>
    </div>

    <div class="lp-showcase__cta reveal">
      <a href="/" class="lp-link-cta">Explore the live club&nbsp;&rarr;</a>
    </div>
  </div>
</section>
<% } %>

<!-- ===== Ritual ===== -->
<section class="lp-ritual">
  <div class="page-container">
    <h2 class="lp-ritual__heading reveal">How GatherBound works</h2>
    <div class="lp-ritual__step reveal">
      <span class="lp-ritual__number" aria-hidden="true">01</span>
      <div class="lp-ritual__body">
        <h2 class="lp-ritual__title">Nominate &amp; Vote</h2>
        <p class="lp-ritual__text">Members scan a QR code and nominate books in seconds. Ranked-choice voting picks the winner, with live results on every device.</p>
      </div>
    </div>
    <div class="lp-ritual__step reveal">
      <span class="lp-ritual__number" aria-hidden="true">02</span>
      <div class="lp-ritual__body">
        <h2 class="lp-ritual__title">Read &amp; Review</h2>
        <p class="lp-ritual__text">Everyone reads on the same timeline. Letter-grade or star-rating reviews, emoji reactions, threaded discussions. Members can participate from anywhere.</p>
      </div>
    </div>
    <div class="lp-ritual__step reveal">
      <span class="lp-ritual__number" aria-hidden="true">03</span>
      <div class="lp-ritual__body">
        <h2 class="lp-ritual__title">Build Your Archive</h2>
        <p class="lp-ritual__text">Every book, review, grade, and conversation becomes a permanent record: the most valuable thing your club owns. Your history grows richer every month.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== Everyone gets a seat (the transformation) ===== -->
<section class="lp-seat">
  <div class="page-container">
    <h2 class="lp-seat__heading reveal">Everyone gets a seat</h2>
    <p class="lp-seat__text reveal">The members who can't make it stop being names on a list. They read on the same timeline, grade the same book, react to the same reviews, and join the same discussion. They go from <span class="lp-seat__quote">&ldquo;I'm on the Meetup&rdquo;</span> to <span class="lp-seat__quote">&ldquo;I'm in this club.&rdquo;</span></p>
    <p class="lp-seat__text reveal">And the meeting itself gets better: people arrive having already talked, so the night in the room is richer than ever. <strong>GatherBound never replaces the meeting. It just lets everyone else in.</strong></p>
  </div>
</section>

<!-- ===== Proof (cover marquee) ===== -->
<section class="lp-proof">
  <% if (recentBooks && recentBooks.length > 0) { %>
  <div class="lp-proof__marquee" aria-hidden="true">
    <div class="lp-proof__track">
      <% for (const book of recentBooks) { %>
      <div class="lp-proof__cover"><img src="<%= book.cover_url %>" alt="<%= book.title %>" loading="lazy"></div>
      <% } %>
      <% /* duplicate for seamless loop */ %>
      <% for (const book of recentBooks) { %>
      <div class="lp-proof__cover"><img src="<%= book.cover_url %>" alt="" loading="lazy"></div>
      <% } %>
    </div>
  </div>
  <% } %>
  <div class="page-container">
    <p class="lp-proof__eyebrow reveal">What one club has built</p>
    <div class="lp-proof__stats reveal">
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalBooks %>">0</span>
        <span class="lp-proof__stat-label">books read</span>
      </div>
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalNominations %>">0</span>
        <span class="lp-proof__stat-label">nominations</span>
      </div>
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalVotesCast %>">0</span>
        <span class="lp-proof__stat-label">votes cast</span>
      </div>
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalReviews %>">0</span>
        <span class="lp-proof__stat-label">reviews written</span>
      </div>
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalEngagement %>">0</span>
        <span class="lp-proof__stat-label">reactions &amp; replies</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== Features ===== -->
<section class="lp-features">
  <div class="page-container">
    <h2 class="lp-features__heading reveal">Built for the whole club, not just the meeting</h2>
    <div class="lp-features__grid">
      <div class="lp-feature reveal">
        <svg class="lp-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 14h3v3"/><path d="M21 14v.01"/><path d="M14 21h.01"/><path d="M17.5 21H21v-3.5"/></svg>
        <strong>Nominate in one scan</strong>
        <span>Attendees scan a QR code and nominate in under 10 seconds. No app download, no login required.</span>
      </div>
      <div class="lp-feature reveal">
        <svg class="lp-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="15" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/></svg>
        <strong>Decide together, fairly</strong>
        <span>Drag-to-rank ballot on mobile and desktop, with live animated results everywhere. Ranked choice, so the winner truly wins.</span>
      </div>
      <div class="lp-feature reveal">
        <svg class="lp-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        <strong>Run the whole month in one place</strong>
        <span>Nominate &rarr; Vote &rarr; Results &rarr; Read. One admin panel runs the entire cycle, so organizing stops being a chore.</span>
      </div>
      <div class="lp-feature reveal">
        <svg class="lp-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <strong>A library that remembers</strong>
        <span>Every read gets a forever-page with beautiful covers, descriptions, meta-data, and custom library links.</span>
      </div>
      <div class="lp-feature reveal">
        <svg class="lp-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <strong>Conversations that don't vanish</strong>
        <span>Reviews, emoji reactions, threaded replies, and an activity feed keep the discussion alive all month, not lost in a chat scroll.</span>
      </div>
      <div class="lp-feature reveal">
        <svg class="lp-feature__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2.5"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
        <strong>Beautiful on every screen</strong>
        <span>Mobile-first and responsive. Gorgeous on the phone in someone's hand, on a laptop, or even a projector.</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== FAQ ===== -->
<section class="lp-faq">
  <div class="page-container">
    <h2 class="lp-faq__heading reveal">Questions, answered</h2>
    <div class="lp-faq__list">
      <details class="lp-faq__item reveal">
        <summary class="lp-faq__q">Do members need to download an app or create an account?</summary>
        <p class="lp-faq__a">No. Anyone can scan a QR code and nominate or vote in seconds. No app, no login. Accounts are optional and free, for members who want to write reviews, react, and keep a profile.</p>
      </details>
      <details class="lp-faq__item reveal">
        <summary class="lp-faq__q">Is it really free?</summary>
        <p class="lp-faq__a">Yes. It's free for every club in the private beta, no credit card to start. When we start charging, we'll let you know in advance with an option to export your data.</p>
      </details>
      <details class="lp-faq__item reveal">
        <summary class="lp-faq__q">How long does it take to set up?</summary>
        <p class="lp-faq__a">Minutes. Tell us about your club and we'll set it up with you personally during the beta. Your first nomination round can go out the same week.</p>
      </details>
      <details class="lp-faq__item reveal">
        <summary class="lp-faq__q">Do we have to leave Meetup or Goodreads?</summary>
        <p class="lp-faq__a">Not at all. Keep Meetup for organizing events and Goodreads for personal tracking. GatherBound is the home for everything that happens around your club: the picks, the votes, the reviews, and the archive.</p>
      </details>
      <details class="lp-faq__item reveal">
        <summary class="lp-faq__q">What kinds of book clubs is it for?</summary>
        <p class="lp-faq__a">Any in-person club, any genre. It's built for — and proven by — a 1,083-member sci-fi and fantasy club, but nothing about it is genre-specific. If your club reads and meets, it fits.</p>
      </details>
      <details class="lp-faq__item reveal">
        <summary class="lp-faq__q">Can I see it in action first?</summary>
        <p class="lp-faq__a">Yes. The SF Fantasy &amp; Sci-Fi Book Club runs on GatherBound, live. <a href="/">Explore the real club&nbsp;&rarr;</a></p>
      </details>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="lp-cta" id="waitlist">
  <div class="page-container">
    <h2 class="lp-cta__heading">Start your club<br>on GatherBound</h2>
    <p class="lp-cta__text">We're onboarding a small first cohort of clubs for our private beta. Tell us about yours and we'll set you up personally.</p>
    <form class="lp-form" id="waitlistForm" novalidate>
      <div class="lp-form__row">
        <label class="lp-form__field">
          <span class="lp-form__label">Your name</span>
          <input class="lp-form__input" type="text" name="name" required autocomplete="name" maxlength="120">
        </label>
        <label class="lp-form__field">
          <span class="lp-form__label">Email</span>
          <input class="lp-form__input" type="email" name="email" required autocomplete="email" maxlength="254">
        </label>
      </div>
      <div class="lp-form__row">
        <label class="lp-form__field">
          <span class="lp-form__label">Club name <span class="lp-form__opt">(optional)</span></span>
          <input class="lp-form__input" type="text" name="clubName" autocomplete="organization" maxlength="120">
        </label>
        <label class="lp-form__field">
          <span class="lp-form__label">City / State <span class="lp-form__opt">(optional)</span></span>
          <input class="lp-form__input" type="text" name="cityState" maxlength="120">
        </label>
      </div>
      <!-- Honeypot: hidden from humans, bots fill it -->
      <input type="text" name="website" class="lp-form__hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button type="submit" class="lp-form__submit">Join the waitlist</button>
      <p class="lp-form__error" id="waitlistError" role="alert" hidden></p>
      <p class="lp-cta__note">No credit card required. Free during beta.</p>
    </form>
    <div class="lp-form__success" id="waitlistSuccess" hidden>
      <p class="lp-form__success-title">You're on the list&nbsp;🎉</p>
      <p class="lp-form__success-text">Thanks — we'll be in touch as we onboard clubs into the beta.</p>
    </div>
  </div>
</section>
