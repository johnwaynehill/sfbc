<!-- ===== Hero ===== -->
<section class="lp-hero">
  <div class="lp-hero__content">
    <p class="lp-hero__eyebrow">GatherBound</p>
    <h1 class="lp-hero__title">Give your book club a home between&nbsp;meetings.</h1>
    <p class="lp-hero__subtitle">The community is always bigger than the room. Give every member a place to nominate, vote, review, and discuss — whether they made it to the meeting or not.</p>
    <div class="lp-hero__actions">
      <a href="#waitlist" class="lp-hero__cta">Join the waitlist</a>
      <a href="/" class="lp-hero__cta lp-hero__cta--ghost">See a live club&nbsp;&rarr;</a>
    </div>
    <% if (totalBooks > 0) { %>
    <p class="lp-hero__trust">
      Already running the <strong>SF Fantasy &amp; Sci-Fi Book Club</strong>
      &middot; <%= totalMembers %> members &middot; <%= totalBooks %> books read &middot; <%= totalReviews %> reviews
    </p>
    <% } %>
  </div>
  <% if (recentBooks && recentBooks.length > 0) { %>
  <div class="lp-hero__covers" aria-hidden="true">
    <% for (const book of recentBooks) { %>
    <div class="lp-hero__cover">
      <% if (book.cover_url) { %>
      <img src="<%= book.cover_url %>" alt="" loading="eager">
      <% } %>
    </div>
    <% } %>
  </div>
  <% } %>
</section>

<!-- ===== Showcase (Peek inside a real club) ===== -->
<% if (showcase) { %>
<section class="lp-showcase">
  <div class="page-container">
    <p class="lp-showcase__eyebrow reveal">Take a peek inside</p>
    <h2 class="lp-showcase__heading reveal">This isn't a mockup. It's a real club, running right now.</h2>
    <p class="lp-showcase__sub reveal">Everything below is live data from the SF Fantasy &amp; Sci-Fi Book Club. Click through and explore it yourself.</p>

    <div class="lp-showcase__grid">
      <!-- Preview 1: the club home -->
      <a class="lp-frame reveal" href="/">
        <div class="lp-frame__bar" aria-hidden="true">
          <span class="lp-frame__dot"></span><span class="lp-frame__dot"></span><span class="lp-frame__dot"></span>
          <span class="lp-frame__url">gatherbound.club</span>
        </div>
        <div class="lp-frame__body">
          <p class="lp-frame__caption">The club's home page</p>
          <div class="lp-preview-hero">
            <div class="lp-preview-hero__cover">
              <img src="<%= showcase.cover_url %>" alt="" loading="lazy">
            </div>
            <div class="lp-preview-hero__meta">
              <span class="lp-preview-pill"><%= showcase.label %></span>
              <span class="lp-preview-hero__title"><%= showcase.title %></span>
              <span class="lp-preview-hero__author">by <%= showcase.author %></span>
            </div>
          </div>
          <p class="lp-preview-label">Recent reads</p>
          <div class="lp-preview-strip">
            <% for (const c of showcase.recentCovers) { %>
            <div class="lp-preview-strip__cover"><img src="<%= c.cover_url %>" alt="" loading="lazy"></div>
            <% } %>
          </div>
        </div>
      </a>

      <!-- Preview 2: a book's archive page -->
      <a class="lp-frame reveal" href="<%= showcase.href %>">
        <div class="lp-frame__bar" aria-hidden="true">
          <span class="lp-frame__dot"></span><span class="lp-frame__dot"></span><span class="lp-frame__dot"></span>
          <span class="lp-frame__url">gatherbound.club<%= showcase.href %></span>
        </div>
        <div class="lp-frame__body">
          <p class="lp-frame__caption">Every book becomes an archive</p>
          <div class="lp-preview-book">
            <div class="lp-preview-book__cover">
              <img src="<%= showcase.cover_url %>" alt="" loading="lazy">
            </div>
            <div class="lp-preview-book__meta">
              <span class="lp-preview-book__title"><%= showcase.title %></span>
              <% if (showcase.avgGrade) { %>
              <div class="lp-preview-grade">
                <span class="lp-preview-grade__badge"><%= showcase.avgGrade %></span>
                <span class="lp-preview-grade__label">Club average<br>from <%= showcase.reviewCount %> review<%= showcase.reviewCount === 1 ? '' : 's' %></span>
              </div>
              <% } %>
            </div>
          </div>
          <% if (showcase.reviewText) { %>
          <blockquote class="lp-preview-review">
            <p class="lp-preview-review__text">&ldquo;<%= showcase.reviewText %>&rdquo;</p>
            <p class="lp-preview-review__by">
              <% if (showcase.reviewGrade) { %><span class="lp-preview-review__grade"><%= showcase.reviewGrade %></span><% } %>
              <%= showcase.reviewer %>
            </p>
          </blockquote>
          <% } %>
        </div>
      </a>
    </div>

    <div class="lp-showcase__cta reveal">
      <a href="/" class="lp-link-cta">Explore the live club&nbsp;&rarr;</a>
    </div>
  </div>
</section>
<% } %>

<!-- ===== Manifesto ===== -->
<section class="lp-manifesto reveal">
  <div class="page-container">
    <blockquote class="lp-manifesto__quote">
      Every growing club hits the same wall.
    </blockquote>
    <div class="lp-manifesto__problems">
      <div class="lp-manifesto__problem">
        <strong>Meetup</strong> gets people in the door — then provides zero engagement between events.
      </div>
      <div class="lp-manifesto__problem">
        <strong>Discord</strong> is ephemeral and overwhelming. A discussion about Chapter 3 disappears in a flood of memes.
      </div>
      <div class="lp-manifesto__problem">
        <strong>Goodreads</strong> is personal. Great for individual tracking, but it doesn't know your club exists.
      </div>
    </div>
  </div>
</section>

<!-- ===== Ritual ===== -->
<section class="lp-ritual">
  <div class="page-container">
    <h2 class="lp-ritual__heading reveal">How GatherBound works</h2>
    <div class="lp-ritual__step reveal">
      <span class="lp-ritual__number" aria-hidden="true">01</span>
      <div class="lp-ritual__body">
        <h2 class="lp-ritual__title">Nominate &amp; Vote</h2>
        <p class="lp-ritual__text">Members scan a QR code and nominate books in seconds. Ranked-choice voting picks the winner — with live results on the big screen.</p>
      </div>
    </div>
    <div class="lp-ritual__step reveal">
      <span class="lp-ritual__number" aria-hidden="true">02</span>
      <div class="lp-ritual__body">
        <h2 class="lp-ritual__title">Read &amp; Review</h2>
        <p class="lp-ritual__text">Everyone reads on the same timeline. Letter-grade reviews, emoji reactions, threaded discussions — participate from anywhere.</p>
      </div>
    </div>
    <div class="lp-ritual__step reveal">
      <span class="lp-ritual__number" aria-hidden="true">03</span>
      <div class="lp-ritual__body">
        <h2 class="lp-ritual__title">Build Your Archive</h2>
        <p class="lp-ritual__text">Every book, review, grade, and conversation becomes a permanent record. Your club's history grows richer every month.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== Proof (cover marquee) ===== -->
<section class="lp-proof">
  <% if (recentBooks && recentBooks.length > 0) { %>
  <div class="lp-proof__marquee" aria-hidden="true">
    <div class="lp-proof__track">
      <% for (const book of recentBooks) { %>
      <div class="lp-proof__cover"><img src="<%= book.cover_url %>" alt="<%= book.title %>" loading="lazy"></div>
      <% } %>
      <% /* duplicate for seamless loop */ %>
      <% for (const book of recentBooks) { %>
      <div class="lp-proof__cover"><img src="<%= book.cover_url %>" alt="" loading="lazy"></div>
      <% } %>
    </div>
  </div>
  <% } %>
  <div class="page-container">
    <p class="lp-proof__eyebrow reveal">By the numbers</p>
    <div class="lp-proof__stats reveal">
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalBooks %>">0</span>
        <span class="lp-proof__stat-label">books read</span>
      </div>
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalReviews %>">0</span>
        <span class="lp-proof__stat-label">reviews written</span>
      </div>
      <div class="lp-proof__stat">
        <span class="lp-proof__stat-num" data-count="<%= totalMembers %>">0</span>
        <span class="lp-proof__stat-label">members</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== Features ===== -->
<section class="lp-features">
  <div class="page-container">
    <h2 class="lp-features__heading reveal">Everything your club needs</h2>
    <div class="lp-features__grid">
      <div class="lp-feature reveal">
        <strong>QR Nominations</strong>
        <span>Attendees scan and nominate in &lt;10 seconds. No app download, no login required.</span>
      </div>
      <div class="lp-feature reveal">
        <strong>Ranked Voting</strong>
        <span>Drag-to-rank ballot on mobile with live animated results on the projector.</span>
      </div>
      <div class="lp-feature reveal">
        <strong>Full Lifecycle</strong>
        <span>Nominations &rarr; Voting &rarr; Reading &rarr; Results. One admin panel runs it all.</span>
      </div>
      <div class="lp-feature reveal">
        <strong>Beautiful Archive</strong>
        <span>Every book gets its own page with covers, reviews, grade distributions, and discussions.</span>
      </div>
      <div class="lp-feature reveal">
        <strong>Member Engagement</strong>
        <span>Reviews, emoji reactions, threaded replies, and an activity feed keep the community alive.</span>
      </div>
      <div class="lp-feature reveal">
        <strong>Works Everywhere</strong>
        <span>Mobile-first responsive design with dark mode. Beautiful on any device, in any lighting.</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== Voices (testimonials) ===== -->
<!--
  PLACEHOLDER TESTIMONIALS — replace the quote text and attribution below with
  real quotes from members/organizers before launch. Remove this whole section
  if you'd rather ship without testimonials than ship placeholders.
-->
<section class="lp-voices">
  <div class="page-container">
    <h2 class="lp-voices__heading reveal">What organizers say</h2>
    <div class="lp-voices__grid">
      <figure class="lp-voice reveal">
        <blockquote class="lp-voice__quote">[Placeholder — add a real organizer quote about running their club on GatherBound.]</blockquote>
        <figcaption class="lp-voice__by">— Organizer name, Club name</figcaption>
      </figure>
      <figure class="lp-voice reveal">
        <blockquote class="lp-voice__quote">[Placeholder — add a real member quote about staying engaged between meetings.]</blockquote>
        <figcaption class="lp-voice__by">— Member name, Club name</figcaption>
      </figure>
      <figure class="lp-voice reveal">
        <blockquote class="lp-voice__quote">[Placeholder — add a quote about the archive, voting, or reviews.]</blockquote>
        <figcaption class="lp-voice__by">— Member name, Club name</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
