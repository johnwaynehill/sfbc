<%
  /**
   * Map a grade letter to its CSS tier class for colored badge.
   * S/A grades → gold, B → green, C → neutral, D/F → red
   */
  function gradeTier(grade) {
    if (!grade) return '';
    var letter = grade.charAt(0).toUpperCase();
    if (letter === 'S') return 'grade-badge--s';
    if (letter === 'A') return 'grade-badge--a';
    if (letter === 'B') return 'grade-badge--b';
    if (letter === 'C') return 'grade-badge--c';
    if (letter === 'D') return 'grade-badge--d';
    if (letter === 'F') return 'grade-badge--f';
    return '';
  }
%>

<section class="section">
  <div class="history-header">
    <h1 class="t-section">My Reviews</h1>

    <% if (reviews.length > 1) { %>
    <div class="history-controls">
      <div class="sort-dropdown" id="sortDropdown">
        <button type="button" class="history-btn" id="sortBtn" aria-label="Sort reviews" aria-haspopup="listbox" aria-expanded="false">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M3 12h12"/><path d="M3 18h6"/></svg>
        </button>
        <ul class="sort-dropdown__menu" id="sortMenu" role="listbox" aria-label="Sort order">
          <li class="sort-dropdown__item is-selected" role="option" data-sort="newest" aria-selected="true">Newest first</li>
          <li class="sort-dropdown__item" role="option" data-sort="oldest" aria-selected="false">Oldest first</li>
          <li class="sort-dropdown__item" role="option" data-sort="highest" aria-selected="false">Highest grade</li>
          <li class="sort-dropdown__item" role="option" data-sort="lowest" aria-selected="false">Lowest grade</li>
        </ul>
      </div>
      <button type="button" class="history-btn" id="searchBtn" aria-label="Search reviews" title="Search">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <div class="history-search" id="searchWrap">
        <svg aria-hidden="true" class="history-search__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="searchInput" class="history-search__input" placeholder="Search title or author..." autocomplete="off">
        <button type="button" class="history-search__close" id="searchClose" aria-label="Close search">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>
    <% } %>
  </div>

  <% if (reviews.length > 0) { %>
    <!-- Grade Summary -->
    <div class="my-reviews-summary">
      <div class="my-reviews-summary__stat">
        <span class="my-reviews-summary__value"><%= reviews.length %></span>
        <span class="my-reviews-summary__label">Review<%= reviews.length !== 1 ? 's' : '' %></span>
      </div>
      <% if (avgGrade) { %>
        <div class="my-reviews-summary__divider"></div>
        <div class="my-reviews-summary__stat">
          <span class="grade-badge <%= gradeTier(avgGrade) %>"><%= avgGrade %></span>
          <span class="my-reviews-summary__label">Avg. Grade</span>
        </div>
      <% } %>
    </div>

    <div class="my-reviews-list" id="reviewsList">
      <% for (const r of reviews) { %>
        <div class="review-card review-card--linked"
             data-title="<%= r.title.toLowerCase() %>"
             data-author="<%= r.author.toLowerCase() %>"
             data-date="<%= r.updated_at %>"
             data-weight="<%= r.weight %>">
          <a href="<%= bookPath(r.title, r.author) %>" class="review-card__cover">
            <% if (r.cover_url) { %>
              <img src="<%= r.cover_url %>"
                   alt="<%= r.title %>"
                   class="review-card__cover-img"
                   loading="lazy">
            <% } else { %>
              <%- include('partials/placeholder-cover', { phTitle: r.title, phSize: 'sm' }) %>
            <% } %>
          </a>
          <div class="review-card__body">
            <div class="review-card__heading">
              <a href="<%= bookPath(r.title, r.author) %>" class="review-card__book-link">
                <strong class="t-body"><%= r.title %></strong>
                <span class="text-secondary">by <%= r.author %></span>
              </a>
              <span class="grade-badge grade-badge--sm <%= gradeTier(r.grade) %>"><%= r.grade %></span>
            </div>
            <% if (r.body_markdown) { %>
              <% var excerpt = stripMarkdown(r.body_markdown); %>
              <p class="review-card__text"><%= excerpt.length > 180 ? excerpt.slice(0, 180) + '\u2026' : excerpt %></p>
            <% } %>
            <span class="review-card__date">
              <%= new Date(r.updated_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </span>
            <div class="review-card__actions">
              <a href="/books/<%= r.author_slug %>/<%= r.title_slug %>/review"
                 class="btn btn--tertiary btn--sm">Edit Review</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <p class="history-no-results" id="noResults" hidden>No reviews match your search.</p>
  <% } else { %>
    <div class="empty-state">
      <p class="empty-state__message">You haven't written any reviews yet.</p>
      <div class="empty-state__cta">
        <a href="/history" class="btn btn--primary">Browse Past Books</a>
      </div>
    </div>
  <% } %>
</section>

<script src="/js/my-reviews-filter.js" defer></script>
