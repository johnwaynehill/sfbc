<section class="review-form-page">
  <!-- Book header -->
  <div class="review-form-page__book">
    <div class="book-cover book-cover--sm">
      <% const coverUrl = getCoverUrl(book); %>
      <% if (coverUrl) { %>
        <img src="<%= coverUrl %>" alt="Cover of <%= book.title %>">
      <% } else { %>
        <%- include('partials/placeholder-cover', { phTitle: book.title, phSize: 'sm' }) %>
      <% } %>
    </div>
    <div>
      <h1 class="t-section"><%= book.title %></h1>
      <p class="t-body text-secondary"><%= book.author %></p>
    </div>
  </div>

  <!-- Review form -->
  <form id="review-form" class="review-form" method="POST"
        action="/api/books/<%= book.id %>/reviews"
        data-book-path="<%= bookPath(book.title, book.author) %>"
        data-book-id="<%= book.id %>">
    <% if (review) { %>
      <input type="hidden" name="_method" value="PUT">
    <% } %>

    <!-- Hidden input that holds the actual grade value -->
    <input type="hidden" name="grade" id="grade-input" value="<%= review ? review.grade : '' %>">

    <!-- Grade Picker (pill strip) -->
    <div class="form-label">Grade</div>
    <div class="grade-picker" id="grade-picker">
      <div class="grade-picker__display">
        <span class="grade-picker__value" id="grade-display"><%= review ? review.grade : '—' %></span>
      </div>
      <div class="grade-picker__strip" id="grade-strip" role="radiogroup" aria-label="Grade">
        <button type="button" class="grade-pill" data-grade="F">F</button>
        <button type="button" class="grade-pill" data-grade="D-">D&minus;</button>
        <button type="button" class="grade-pill" data-grade="D">D</button>
        <button type="button" class="grade-pill" data-grade="D+">D+</button>
        <button type="button" class="grade-pill" data-grade="C-">C&minus;</button>
        <button type="button" class="grade-pill" data-grade="C">C</button>
        <button type="button" class="grade-pill" data-grade="C+">C+</button>
        <button type="button" class="grade-pill" data-grade="B-">B&minus;</button>
        <button type="button" class="grade-pill" data-grade="B">B</button>
        <button type="button" class="grade-pill" data-grade="B+">B+</button>
        <button type="button" class="grade-pill" data-grade="A-">A&minus;</button>
        <button type="button" class="grade-pill" data-grade="A">A</button>
        <button type="button" class="grade-pill" data-grade="A+">A+</button>
        <button type="button" class="grade-pill" data-grade="S">S</button>
      </div>
    </div>

    <!-- Review section (optional) -->
    <div class="form-label">
      <div style="display:flex;align-items:baseline;gap:var(--s-2);">
        <span>Review</span>
        <span class="text-secondary" style="font-weight:400;font-size:var(--t-xs);">optional</span>
      </div>
    </div>

    <div id="review-editor">
      <!-- Markdown toolbar -->
      <div class="md-toolbar" id="md-toolbar">
        <button type="button" class="md-toolbar__btn" data-action="bold" title="Bold (**text**)">
          <strong>B</strong>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="italic" title="Italic (*text*)">
          <em>I</em>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="list" title="Bulleted list (- item)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="quote" title="Blockquote (> text)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="3" y1="6" x2="3" y2="18"/>
            <line x1="7" y1="10" x2="18" y2="10"/><line x1="7" y1="14" x2="15" y2="14"/>
          </svg>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="spoiler" title="Spoiler (||text||)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
            <line x1="1" y1="1" x2="23" y2="23"/>
          </svg>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="link" title="Link ([text](url))">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="strikethrough" title="Strikethrough (~~text~~)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4H9a3 3 0 0 0 0 6h6a3 3 0 0 1 0 6H8"/><line x1="4" y1="12" x2="20" y2="12"/>
          </svg>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="heading" title="Heading (### text)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 4v16"/><path d="M18 4v16"/><path d="M6 12h12"/>
          </svg>
        </button>
        <button type="button" class="md-toolbar__btn" data-action="ordered-list" title="Numbered list (1. item)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/>
            <text x="3" y="7" font-size="7" fill="currentColor" stroke="none" font-family="sans-serif">1</text>
            <text x="3" y="13" font-size="7" fill="currentColor" stroke="none" font-family="sans-serif">2</text>
            <text x="3" y="19" font-size="7" fill="currentColor" stroke="none" font-family="sans-serif">3</text>
          </svg>
        </button>
        <span class="md-toolbar__spacer"></span>
        <button type="button" class="md-toolbar__btn md-toolbar__btn--preview" data-action="preview" id="toolbar-preview" title="Toggle preview">
          Preview
        </button>
      </div>

      <!-- Textarea + Preview pane -->
      <textarea name="body" id="review-body" class="form-textarea form-textarea--toolbar" rows="8"
                placeholder="What did you think of this book?"><%= review ? review.body_markdown : '' %></textarea>
      <div class="review-preview" id="review-preview" hidden></div>

      <!-- Character count -->
      <div class="char-count" id="char-count">0 / 10,000</div>
    </div>

    <label class="spoiler-checkbox">
      <input type="checkbox" name="has_spoilers" id="has-spoilers" value="1"
             <%= (review && review.has_spoilers) ? 'checked' : '' %>>
      <span class="spoiler-checkbox__label">This review contains spoilers</span>
    </label>

    <label class="finish-checkbox">
      <input type="checkbox" name="did_finish" id="did-finish" value="1"
             <%= (!review || review.did_finish) ? 'checked' : '' %>>
      <span class="finish-checkbox__label">I finished this book</span>
    </label>

    <div id="review-message" hidden></div>

    <div class="review-form__actions">
      <button type="submit" class="btn btn--primary" id="review-submit">
        <%= review ? 'Update Review' : 'Submit Review' %>
      </button>
      <a href="<%= bookPath(book.title, book.author) %>" class="btn btn--ghost">Cancel</a>
    </div>
  </form>
</section>

<script src="/js/review-form.js" defer></script>
