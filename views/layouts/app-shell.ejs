<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' + club.name : club.name %></title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <%- include('../partials/global-nav') %>

  <main>
    <div class="page-container">
      <%- body %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="page-container">
      <span class="t-nav text-tertiary">&copy; 2026 <%= club.name %></span>
      <a href="<%= club.meetupUrl %>" class="footer-link t-nav" target="_blank" rel="noopener">Meetup</a>
    </div>
  </footer>
</body>
</html>
