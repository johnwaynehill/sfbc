<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= club.tagline %>">
  <meta name="theme-color" content="#000000">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' + club.name : club.name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/icons/favicon-16x16.png">
  <link rel="stylesheet" href="/css/tokens.css?v=16">
  <link rel="stylesheet" href="/css/base.css?v=16">
  <link rel="stylesheet" href="/css/components.css?v=39">
  <script>(function(){var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)})()</script>
</head>
<body>
  <%- include('../partials/global-nav') %>

  <main>
    <div class="page-container">
      <%- body %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="page-container">
      <span class="t-nav text-tertiary">&copy; 2026 <%= club.name %></span>
      <div class="footer-links">
        <a href="/changelog" class="footer-link t-nav">What's New</a>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSfrx-QWzj6Fwz1NLDLMDsSqkZIfqZffOn4pDEFKnQjfNxgJnA/viewform?usp=publish-editor" class="footer-link t-nav" target="_blank" rel="noopener">Feedback</a>
      </div>
    </div>
  </footer>

  <script src="/js/theme.js?v=1" defer></script>
  <script src="/js/nav.js?v=7" defer></script>
  <script src="/js/spoiler.js?v=7" defer></script>
  <script src="/js/history-filter.js?v=7" defer></script>
  <script src="/js/review-actions.js?v=7" defer></script>
  <script src="/js/reactions.js?v=1" defer></script>
  <script src="/js/replies.js?v=1" defer></script>
  <script src="/js/share.js?v=1" defer></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=1" defer></script>
  <% } %>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    }
  </script>
</body>
</html>
