</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <%- include('../partials/global-nav') %>

  <main id="main-content">
    <div class="page-container">
      <%- body %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="page-container">
      <span class="t-nav text-tertiary">&copy; 2026 <%= club.name %></span>
      <div class="footer-links">
        <a href="/changelog" class="footer-link t-nav">What's New</a>
        <a href="https://docs.google.com/forms/d/e/1FAIpQLSfrx-QWzj6Fwz1NLDLMDsSqkZIfqZffOn4pDEFKnQjfNxgJnA/viewform?usp=publish-editor" class="footer-link t-nav" target="_blank" rel="noopener">Feedback</a>
      </div>
    </div>
  </footer>

  <script src="/js/dialog.js?v=1" defer></script>
  <script src="/js/theme.js?v=2" defer></script>
  <script src="/js/nav.js?v=7" defer></script>
  <script src="/js/spoiler.js?v=7" defer></script>
  <script src="/js/history-filter.js?v=7" defer></script>
  <script src="/js/review-actions.js?v=8" defer></script>
  <script src="/js/reactions.js?v=1" defer></script>
  <script src="/js/replies.js?v=2" defer></script>
  <script src="/js/share.js?v=1" defer></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=3" defer></script>
  <% } %>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    }
  </script>
</body>
</html>
