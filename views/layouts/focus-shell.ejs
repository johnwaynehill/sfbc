    </div>
  </main>

  <script src="/js/dialog.js?v=1" defer></script>
  <script src="/js/theme.js?v=1" defer></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=7" defer></script>
  <% } %>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(function () {});
    }
  </script>
</body>
</html>
