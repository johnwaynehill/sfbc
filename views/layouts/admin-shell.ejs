<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000000">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | Admin' : 'Admin' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="icon" type="image/png" sizes="32x32" href="/img/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/icons/favicon-16x16.png">
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css?v=2">
</head>
<body>
  <nav class="admin-nav" role="navigation" aria-label="Admin navigation">
    <div class="page-container">
      <a href="/admin" class="nav-brand t-brand">
        <% if (user) { %>
          <%
            var dn = user.display_name || user.email;
            var words = dn.trim().split(/\s+/);
            var initials = words.length >= 2
              ? words[0].charAt(0).toUpperCase() + words[1].charAt(0).toUpperCase()
              : words[0].charAt(0).toUpperCase();
          %>
          <span class="nav-avatar"><%= initials %></span>
        <% } %>
        Admin
      </a>
      <ul class="nav-links">
        <li><a href="/admin" class="t-nav<%= adminPath === '/' ? ' is-active' : '' %>">Overview</a></li>
        <li><a href="/admin/meetings" class="t-nav<%= adminPath && adminPath.startsWith('/meetings') ? ' is-active' : '' %>">Meetings</a></li>
        <li><a href="/admin/settings" class="t-nav<%= adminPath === '/settings' ? ' is-active' : '' %>">Settings</a></li>
      </ul>
      <a href="/" class="admin-nav__site-link" target="_blank" rel="noopener">View Site &rarr;</a>
    </div>
  </nav>

  <main>
    <div class="page-container">
      <%- body %>
    </div>
  </main>

  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=3" defer></script>
  <% } %>
</body>
</html>
