<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000000">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | Admin' : 'Admin' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="icon" type="image/png" sizes="32x32" href="/img/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/icons/favicon-16x16.png">
  <link rel="stylesheet" href="/css/tokens.css?v=16">
  <link rel="stylesheet" href="/css/base.css?v=16">
  <link rel="stylesheet" href="/css/components.css?v=33">
  <script>(function(){var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)})()</script>
</head>
<body>
  <nav class="admin-nav" role="navigation" aria-label="Admin navigation">
    <div class="page-container">
      <a href="/admin" class="nav-brand t-brand">
        <% if (user) { %>
          <%- include('../partials/avatar', { avatarUser: user, avatarSize: 'sm', avatarClass: 'nav-avatar' }) %>
        <% } %>
        Admin
      </a>

      <button class="nav-toggle admin-nav__toggle" aria-label="Toggle menu" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="3" y1="5" x2="17" y2="5"/>
          <line x1="3" y1="10" x2="17" y2="10"/>
          <line x1="3" y1="15" x2="17" y2="15"/>
        </svg>
      </button>

      <ul class="nav-links">
        <li><a href="/admin" class="t-nav<%= adminPath === '/' ? ' is-active' : '' %>">Overview</a></li>
        <li><a href="/admin/meetings" class="t-nav<%= adminPath && adminPath.startsWith('/meetings') ? ' is-active' : '' %>">Meetings</a></li>
        <li><a href="/admin/users" class="t-nav<%= adminPath && adminPath.startsWith('/users') ? ' is-active' : '' %>">Users</a></li>
        <li><a href="/admin/reviews" class="t-nav<%= adminPath && adminPath.startsWith('/reviews') ? ' is-active' : '' %>">Reviews</a></li>
        <li><a href="/admin/announcements" class="t-nav<%= adminPath && adminPath.startsWith('/announcements') ? ' is-active' : '' %>">Announcements</a></li>
        <li><a href="/admin/settings" class="t-nav<%= adminPath === '/settings' ? ' is-active' : '' %>">Settings</a></li>
        <li class="admin-nav__extras">
          <a href="/" class="admin-nav__site-link" target="_blank" rel="noopener">View Site &rarr;</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </li>
      </ul>
    </div>
  </nav>

  <main>
    <div class="page-container">
      <%- body %>
    </div>
  </main>

  <script src="/js/nav.js?v=8" defer></script>
  <script src="/js/theme.js?v=1" defer></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
    <script src="<%= pageScript %>?v=7" defer></script>
  <% } %>
</body>
</html>
