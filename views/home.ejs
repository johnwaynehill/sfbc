<!-- ===== Announcements ===== -->
<% if (announcements && announcements.length > 0) { %>
<div class="announcements">
  <% for (const a of announcements) { %>
    <div class="announcement announcement--<%= a.type %>">
      <div class="announcement__icon">
        <% if (a.type === 'warning') { %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <% } else if (a.type === 'success') { %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <% } else { %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <% } %>
      </div>
      <div class="announcement__content">
        <strong class="announcement__title"><%= a.title %></strong>
        <% if (a.body) { %>
          <p class="announcement__body"><%= a.body %></p>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
<% } %>

<% if (currentMeeting) { %>
<!-- ===== Book Hero ===== -->
<section class="book-hero">
  <a href="<%= bookPath(currentMeeting.title, currentMeeting.author) %>" class="book-cover book-cover--lg">
    <% const heroUrl = getCoverUrl(currentMeeting); %>
    <% if (heroUrl) { %>
      <img src="<%= heroUrl %>" alt="Cover of <%= currentMeeting.title %>">
    <% } else { %>
      <div class="placeholder-cover">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
        </svg>
      </div>
    <% } %>
  </a>

  <div class="book-hero__body">
    <div class="book-hero__meta book-hero__meta--stacked">
      <span class="status-pill status-pill--<%= currentMeeting.status %>">
        <span class="status-pill__dot"></span>
        <%= formatStatus(currentMeeting.status) %>
      </span>
      <span class="t-label text-tertiary"><%= formatMonthYear(currentMeeting.month_year) %></span>
    </div>
    <h1 class="t-display book-hero__title"><%= currentMeeting.title %></h1>
    <p class="t-author"><%= currentMeeting.author %></p>

    <% if (typeof heroSubjects !== 'undefined' && heroSubjects.length > 0) { %>
      <div class="book-hero__tags">
        <% heroSubjects.slice(0, 5).forEach(function(tag) { %>
          <span class="book-tag"><%= tag %></span>
        <% }); %>
      </div>
    <% } %>

    <% if (currentMeeting.description) { %>
      <div class="book-description">
        <p class="book-description__text"><%= currentMeeting.description %></p>
      </div>
    <% } %>

    <div class="book-hero__actions">
      <a href="<%= bookPath(currentMeeting.title, currentMeeting.author) %>" class="btn-primary">View Details</a>
    </div>

    <% if (currentMeeting.meeting_time || currentMeeting.location_text) { %>
      <div class="book-hero__meeting-info">
        <% if (currentMeeting.meeting_time) { %>
          <span class="meeting-info__item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
            <%= formatMeetingTime(currentMeeting.meeting_time) %>
          </span>
        <% } %>
        <% if (currentMeeting.location_text) { %>
          <span class="meeting-info__item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= currentMeeting.location_text %>
          </span>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<!-- ===== Banner CTA ===== -->
<% if (activeMeeting && activeMeeting.status === 'nominations') { %>
<section class="section" style="padding-top: 0;">
  <div class="banner">
    <div class="banner__text">
      <p class="t-body" style="color: inherit;"><strong>Nominations are open</strong> for <%= formatMonthYear(activeMeeting.month_year) %>. Submit your pick!</p>
    </div>
    <a href="/nominate" class="btn-primary">Nominate a Book</a>
  </div>
</section>
<% } else if (activeMeeting && activeMeeting.status === 'voting') { %>
<section class="section" style="padding-top: 0;">
  <div class="banner">
    <div class="banner__text">
      <p class="t-body" style="color: inherit;"><strong>Voting is open</strong> for <%= formatMonthYear(activeMeeting.month_year) %>. Cast your vote!</p>
    </div>
    <a href="/vote" class="btn-primary">Vote Now</a>
  </div>
</section>
<% } %>

<% } else { %>
<!-- ===== Empty State (no reading book) ===== -->
<% if (activeMeeting && activeMeeting.status === 'nominations') { %>
<section class="section">
  <div class="banner">
    <div class="banner__text">
      <p class="t-body" style="color: inherit;"><strong>Nominations are open</strong> for <%= formatMonthYear(activeMeeting.month_year) %>. Submit your pick!</p>
    </div>
    <a href="/nominate" class="btn-primary">Nominate a Book</a>
  </div>
</section>
<% } else if (activeMeeting && activeMeeting.status === 'voting') { %>
<section class="section">
  <div class="banner">
    <div class="banner__text">
      <p class="t-body" style="color: inherit;"><strong>Voting is open</strong> for <%= formatMonthYear(activeMeeting.month_year) %>. Cast your vote!</p>
    </div>
    <a href="/vote" class="btn-primary">Vote Now</a>
  </div>
</section>
<% } else { %>
<div class="empty-state" style="padding: var(--s-7) 0;">
  <p class="empty-state__message">No books selected yet. Check back soon!</p>
</div>
<% } %>
<% } %>

<!-- ===== Recent History Strip ===== -->
<% if (recentBooks.length > 0) { %>
<section class="section">
  <div class="section-header">
    <h2 class="t-section">Recent Reads</h2>
    <a href="/history" class="btn-quiet">View all &rarr;</a>
  </div>
  <div class="history-strip">
    <% for (const book of recentBooks) { %>
      <a href="<%= bookPath(book.title, book.author) %>" class="book-card book-card--strip">
        <div class="book-card__cover">
          <% const coverUrl = getCoverUrl(book); %>
          <% if (coverUrl) { %>
            <img src="<%= coverUrl %>" alt="Cover of <%= book.title %>" loading="lazy">
          <% } else { %>
            <div class="placeholder-cover">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
              </svg>
            </div>
          <% } %>
        </div>
        <div class="book-card__title"><%= book.title %></div>
        <div class="book-card__author"><%= book.author %></div>
        <div class="book-card__footer">
          <span class="t-label text-tertiary"><%= formatMonthYear(book.month_year) %></span>
        </div>
      </a>
    <% } %>
  </div>
</section>
<% } %>

<!-- ===== Upcoming Books ===== -->
<% if (upcomingMeetings && upcomingMeetings.length > 0) { %>
<section class="section upcoming-section">
  <div class="section-header">
    <h2 class="t-section">Coming Up</h2>
  </div>
  <ol class="upcoming-docket">
    <% for (const mtg of upcomingMeetings) { %>
      <li class="upcoming-docket__item">
        <div class="upcoming-docket__marker">
          <span class="upcoming-docket__month"><%= formatMonthYear(mtg.month_year) %></span>
        </div>
        <% if (mtg.title) { %>
          <a href="<%= bookPath(mtg.title, mtg.author) %>" class="upcoming-docket__card">
            <div class="upcoming-docket__cover">
              <% const upCoverUrl = getCoverUrl(mtg); %>
              <% if (upCoverUrl) { %>
                <img src="<%= upCoverUrl %>" alt="Cover of <%= mtg.title %>" loading="lazy">
              <% } else { %>
                <div class="placeholder-cover">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
                  </svg>
                </div>
              <% } %>
            </div>
            <div class="upcoming-docket__text">
              <span class="upcoming-docket__title"><%= mtg.title %></span>
              <span class="upcoming-docket__author"><%= mtg.author %></span>
              <% if (mtg.meeting_time || mtg.location_text) { %>
                <span class="upcoming-docket__details">
                  <% if (mtg.meeting_time) { %>
                    <%= formatMeetingTime(mtg.meeting_time, 'short') %>
                  <% } %>
                  <% if (mtg.meeting_time && mtg.location_text) { %> · <% } %>
                  <% if (mtg.location_text) { %><%= mtg.location_text %><% } %>
                </span>
              <% } %>
            </div>
          </a>
        <% } else { %>
          <div class="upcoming-docket__card upcoming-docket__card--tbd">
            <div class="upcoming-docket__cover upcoming-docket__cover--tbd">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75"/>
                <circle cx="12" cy="18" r=".75" fill="currentColor" stroke="none"/>
              </svg>
            </div>
            <div class="upcoming-docket__text">
              <span class="upcoming-docket__title upcoming-docket__title--tbd">To Be Decided</span>
              <span class="upcoming-docket__author">Book selection coming soon</span>
              <% if (mtg.meeting_time || mtg.location_text) { %>
                <span class="upcoming-docket__details">
                  <% if (mtg.meeting_time) { %>
                    <%= formatMeetingTime(mtg.meeting_time, 'short') %>
                  <% } %>
                  <% if (mtg.meeting_time && mtg.location_text) { %> · <% } %>
                  <% if (mtg.location_text) { %><%= mtg.location_text %><% } %>
                </span>
              <% } %>
            </div>
          </div>
        <% } %>
      </li>
    <% } %>
  </ol>
</section>
<% } %>

<!-- ===== About ===== -->
<section class="about-section">
  <div class="about-section__content">
    <h2 class="t-section" style="margin-bottom: var(--s-2);">About the Club</h2>
    <p class="t-body text-secondary"><%= club.tagline %></p>
    <div class="about-section__stat">
      <span class="t-stat"><%= totalBooks %></span>
      <span class="t-body text-secondary">books read so far</span>
    </div>
    <div style="margin-top: var(--s-3);">
      <a href="<%= club.meetupUrl %>" class="btn-secondary" target="_blank" rel="noopener">Join us on Meetup</a>
    </div>
  </div>
</section>
