<section class="admin-page">
  <h1 class="t-section admin-page__heading"><%= pageTitle %></h1>

  <!-- Create form -->
  <div class="admin-settings-card">
    <h2 class="t-body-bold">New Announcement</h2>
    <form id="announcement-form" class="admin-form" style="margin-top: var(--s-2);">
      <div style="display: flex; gap: var(--s-2); flex-wrap: wrap;">
        <select name="type" class="form-select" style="width: auto;">
          <option value="info">Info</option>
          <option value="success">Success</option>
          <option value="warning">Warning</option>
        </select>
        <input type="text" name="title" class="form-input" placeholder="Title (required)" maxlength="200" required style="flex: 1; min-width: 200px;">
      </div>
      <textarea name="body" class="form-textarea" placeholder="Body text (optional)" maxlength="1000" rows="2" style="margin-top: var(--s-2);"></textarea>
      <div style="display: flex; gap: var(--s-2); align-items: center; margin-top: var(--s-2);">
        <label class="t-caption text-secondary" for="expires-at">Expires:</label>
        <input type="datetime-local" name="expires_at" id="expires-at" class="form-input" style="width: auto;">
        <button type="submit" class="btn btn--primary btn--sm" id="announcement-submit">Create</button>
      </div>
    </form>
    <div id="announcement-message" hidden></div>
  </div>

  <!-- Existing announcements -->
  <div class="admin-settings-card">
    <h2 class="t-body-bold">All Announcements</h2>
    <% if (announcements.length === 0) { %>
      <p class="t-body text-secondary" style="margin-top: var(--s-2);">No announcements yet.</p>
    <% } else { %>
      <div class="announcement-admin-list" id="announcement-list">
        <% for (const a of announcements) { %>
          <div class="announcement-admin-item<%= a.is_active ? '' : ' is-inactive' %>" data-id="<%= a.id %>">
            <div class="announcement-admin-item__header">
              <span class="announcement-type-badge announcement-type-badge--<%= a.type %>"><%= a.type %></span>
              <strong class="t-body-bold"><%= a.title %></strong>
              <% if (!a.is_active) { %>
                <span class="t-caption text-tertiary">(inactive)</span>
              <% } %>
            </div>
            <% if (a.body) { %>
              <p class="t-caption text-secondary"><%= a.body %></p>
            <% } %>
            <div class="announcement-admin-item__meta">
              <span class="t-caption text-tertiary">
                Created <%= new Date(a.created_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                <% if (a.created_by_name) { %> by <%= a.created_by_name %><% } %>
              </span>
              <% if (a.expires_at) { %>
                <span class="t-caption text-tertiary">
                  &middot; Expires <%= new Date(a.expires_at + 'Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
              <% } %>
            </div>
            <div class="announcement-admin-item__actions">
              <% if (a.is_active) { %>
                <button type="button" class="btn btn--ghost btn--sm" data-action="deactivate" data-id="<%= a.id %>">Deactivate</button>
              <% } else { %>
                <button type="button" class="btn btn--ghost btn--sm" data-action="activate" data-id="<%= a.id %>">Activate</button>
              <% } %>
              <button type="button" class="btn btn--danger btn--sm" data-action="delete" data-id="<%= a.id %>">Delete</button>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
