<section class="admin-page">
  <% if (!meeting) { %>
    <!-- Create new pick form -->
    <h1 class="t-section admin-page__heading">New Pick</h1>

    <form id="create-meeting-form" class="admin-form">
      <label class="form-label">
        Pick Month
        <input type="month" name="month_year" class="form-input" required autofocus>
      </label>

      <label class="form-label">
        Meetup Event URL <span class="text-secondary">(optional)</span>
        <input type="url" name="meetup_event_url" class="form-input"
               placeholder="https://www.meetup.com/...">
      </label>

      <label class="form-label">
        Event Date &amp; Time <span class="text-secondary">(optional)</span>
        <input type="datetime-local" name="meeting_time" class="form-input">
      </label>

      <label class="form-label">
        Location <span class="text-secondary">(optional)</span>
        <input type="text" name="location_text" class="form-input"
               placeholder="e.g. The Interval, San Francisco">
      </label>

      <div id="create-message" hidden></div>

      <button type="submit" class="btn btn--primary" id="create-submit">
        Create Pick
      </button>
    </form>

  <% } else { %>
    <!-- Existing pick detail -->
    <a href="/admin/picks" class="admin-back-link t-caption">&larr; All Picks</a>

    <div class="admin-page__header-row">
      <h1 class="t-section"><%= formatMonthYear(meeting.month_year) %></h1>
      <span class="status-pill status-pill--<%= meeting.status %>"><%= formatStatus(meeting.status) %></span>
    </div>

    <!-- Lifecycle stepper -->
    <%
      var steps = ['scheduled', 'nominations', 'voting', 'upcoming', 'reading', 'results'];
      var stepLabels = { scheduled: 'Scheduled', nominations: 'Nominations', voting: 'Voting', upcoming: 'Upcoming', reading: 'Reading', results: 'Finished' };
      var currentIdx = steps.indexOf(meeting.status);
    %>
    <div class="lifecycle-stepper">
      <% steps.forEach(function(step, i) { %>
        <% if (i > 0) { %>
          <span class="lifecycle-step__connector"></span>
        <% } %>
        <span class="lifecycle-step<%= i < currentIdx ? ' lifecycle-step--done' : '' %><%= i === currentIdx ? ' lifecycle-step--active' : '' %>">
          <span class="lifecycle-step__dot"></span>
          <%= stepLabels[step] %>
        </span>
      <% }); %>
    </div>

    <!-- Pipeline Panel — guided wizard per phase -->
    <%
      var _slug = monthYearSlug(meeting.month_year);
      var _nomineeCount = nominees.length;
      var _nomineesReady = _nomineeCount >= 2;
      var _voteCount = typeof voteCount !== 'undefined' ? voteCount : 0;
      var _votesReady = _voteCount >= 1;
      var _hasVoteData = results && results.rankings && results.rankings.length > 0;
      var _nParts = meeting.month_year.split('-');
      var _nY = parseInt(_nParts[0], 10);
      var _nM = parseInt(_nParts[1], 10) + 1;
      if (_nM > 12) { _nM = 1; _nY++; }
      var _nextMonth = _nY + '-' + (_nM < 10 ? '0' + _nM : '' + _nM);
    %>
    <div class="pipeline-panel pipeline-panel--<%= meeting.status %>">

      <% if (meeting.status === 'scheduled') { %>
        <div class="pipeline-panel__header">
          <span class="pipeline-panel__icon">📋</span>
          <div class="pipeline-panel__titles">
            <span class="pipeline-panel__label">Scheduled</span>
            <span class="pipeline-panel__desc">
              Open nominations to let members suggest books.
            </span>
          </div>
        </div>
        <div class="pipeline-panel__actions">
          <button class="btn btn--primary pipeline-cta js-advance-status"
                  data-meeting-id="<%= meeting.id %>"
                  data-new-status="nominations">
            Open Nominations →
          </button>
        </div>

      <% } else if (meeting.status === 'upcoming') { %>
        <div class="pipeline-panel__header">
          <span class="pipeline-panel__icon">📚</span>
          <div class="pipeline-panel__titles">
            <span class="pipeline-panel__label">Upcoming</span>
            <span class="pipeline-panel__desc">
              The winning book has been determined. Start reading when the club is ready.
            </span>
          </div>
        </div>
        <div class="pipeline-panel__checks">
          <span class="pipeline-check pipeline-check--ok">
            <span class="pipeline-check__icon">✓</span>
            Winner: <strong><%= meeting.book_title %></strong> by <%= meeting.book_author %>
          </span>
        </div>
        <div class="pipeline-panel__actions">
          <button class="btn btn--primary pipeline-cta js-advance-status"
                  data-meeting-id="<%= meeting.id %>"
                  data-new-status="reading">
            Start Reading →
          </button>
          <% if (_hasVoteData) { %>
            <a href="/results/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
              📊 View results <span class="pipeline-link__arrow">↗</span>
            </a>
          <% } %>
        </div>

      <% } else if (meeting.status === 'nominations') { %>
        <div class="pipeline-panel__header">
          <span class="pipeline-panel__icon">📣</span>
          <div class="pipeline-panel__titles">
            <span class="pipeline-panel__label">Nominations Open</span>
            <span class="pipeline-panel__desc">
              Members are nominating books for <%= formatMonthYear(meeting.month_year) %>.
            </span>
          </div>
        </div>
        <div class="pipeline-panel__checks">
          <span class="pipeline-check<%= _nomineesReady ? ' pipeline-check--ok' : ' pipeline-check--warn' %>">
            <span class="pipeline-check__icon"><%= _nomineesReady ? '✓' : '!' %></span>
            <span id="pipeline-nominee-count"><%= _nomineeCount %></span> nominee<%= _nomineeCount !== 1 ? 's' : '' %>
            <% if (!_nomineesReady) { %><span class="pipeline-check__hint">(need at least 2)</span><% } %>
          </span>
        </div>
        <div class="pipeline-panel__links">
          <a href="/nominate/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
            📱 Nominate page <span class="pipeline-link__arrow">↗</span>
          </a>
          <a href="/nominations/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
            👀 Live view <span class="pipeline-link__arrow">↗</span>
          </a>
        </div>
        <div class="pipeline-panel__actions">
          <button class="btn btn--primary pipeline-cta js-advance-status"
                  data-meeting-id="<%= meeting.id %>"
                  data-new-status="voting"
                  <%= !_nomineesReady ? 'disabled' : '' %>>
            Close Nominations & Open Voting →
          </button>
        </div>

      <% } else if (meeting.status === 'voting') { %>
        <div class="pipeline-panel__header">
          <span class="pipeline-panel__icon">🗳️</span>
          <div class="pipeline-panel__titles">
            <span class="pipeline-panel__label">Voting Open</span>
            <span class="pipeline-panel__desc">
              Members are ranking <%= _nomineeCount %> nominee<%= _nomineeCount !== 1 ? 's' : '' %>.
            </span>
          </div>
        </div>
        <div class="pipeline-panel__checks">
          <span class="pipeline-check<%= _votesReady ? ' pipeline-check--ok' : ' pipeline-check--warn' %>">
            <span class="pipeline-check__icon"><%= _votesReady ? '✓' : '!' %></span>
            <span id="admin-vote-count"><%= _voteCount %></span> vote<%= _voteCount !== 1 ? 's' : '' %> cast
            <% if (!_votesReady) { %><span class="pipeline-check__hint">(need at least 1)</span><% } %>
          </span>
        </div>
        <div class="pipeline-panel__links">
          <a href="/vote/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
            🗳️ Voting page <span class="pipeline-link__arrow">↗</span>
          </a>
          <% if (_hasVoteData) { %>
            <a href="/results/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
              📊 Live results <span class="pipeline-link__arrow">↗</span>
            </a>
          <% } %>
        </div>
        <div class="pipeline-panel__actions">
          <button class="btn btn--primary pipeline-cta js-advance-status"
                  data-meeting-id="<%= meeting.id %>"
                  data-new-status="upcoming"
                  <%= !_votesReady ? 'disabled' : '' %>>
            Close Voting & Determine Winner →
          </button>
        </div>

      <% } else if (meeting.status === 'reading') { %>
        <div class="pipeline-panel__header">
          <span class="pipeline-panel__icon">📖</span>
          <div class="pipeline-panel__titles">
            <span class="pipeline-panel__label">Currently Reading</span>
            <span class="pipeline-panel__desc">
              The club is reading <strong><%= meeting.book_title %></strong>. Mark as finished when the discussion is done.
            </span>
          </div>
        </div>
        <div class="pipeline-panel__actions">
          <button class="btn btn--primary pipeline-cta js-advance-status"
                  data-meeting-id="<%= meeting.id %>"
                  data-new-status="results">
            Mark as Finished →
          </button>
          <% if (_hasVoteData) { %>
            <a href="/results/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
              📊 View results <span class="pipeline-link__arrow">↗</span>
            </a>
          <% } %>
        </div>

      <% } else if (meeting.status === 'results') { %>
        <div class="pipeline-panel__header">
          <span class="pipeline-panel__icon">🏆</span>
          <div class="pipeline-panel__titles">
            <span class="pipeline-panel__label">Complete</span>
            <span class="pipeline-panel__desc">
              <% if (meeting.book_title) { %>
                Winner: <strong><%= meeting.book_title %></strong> by <%= meeting.book_author %>.
              <% } else { %>
                This pick is finished.
              <% } %>
            </span>
          </div>
        </div>
        <div class="pipeline-panel__actions">
          <a href="/admin/picks/new?month=<%= encodeURIComponent(_nextMonth) %>" class="btn btn--primary pipeline-cta">
            Create Next Pick →
          </a>
          <% if (_hasVoteData) { %>
            <a href="/results/<%= _slug %>" class="pipeline-link" target="_blank" rel="noopener">
              📊 View public results <span class="pipeline-link__arrow">↗</span>
            </a>
          <% } %>
        </div>
      <% } %>

      <!-- Footer: Edit Details + Manual Override -->
      <div class="pipeline-panel__footer">
        <button type="button" class="btn btn--secondary btn--sm" id="toggle-edit-btn">Edit Details</button>
        <details class="pipeline-override">
          <summary class="pipeline-override__toggle">Manual Override</summary>
          <div class="pipeline-override__body">
            <div class="admin-status-override">
              <label class="t-caption text-secondary" for="status-override-select">Set status:</label>
              <select id="status-override-select" class="form-input form-input--sm"
                      data-meeting-id="<%= meeting.id %>"
                      data-current-status="<%= meeting.status %>">
                <option value="">Change&hellip;</option>
                <option value="scheduled"<%= meeting.status === 'scheduled' ? ' disabled' : '' %>>Scheduled</option>
                <option value="upcoming"<%= meeting.status === 'upcoming' ? ' disabled' : '' %>>Upcoming</option>
                <option value="reading"<%= meeting.status === 'reading' ? ' disabled' : '' %>>Reading</option>
                <option value="nominations"<%= meeting.status === 'nominations' ? ' disabled' : '' %>>Nominations</option>
                <option value="voting"<%= meeting.status === 'voting' ? ' disabled' : '' %>>Voting</option>
                <option value="results"<%= meeting.status === 'results' ? ' disabled' : '' %>>Finished</option>
              </select>
              <button type="button" class="btn btn--secondary btn--sm" id="status-override-btn" disabled>Apply</button>
            </div>
          </div>
        </details>
      </div>
    </div>

    <%- include('../partials/qr-panel') %>

    <!-- Selected book / Winner callout -->
    <% if (meeting.winning_book_id && meeting.book_title) { %>
      <div class="admin-winner<%= meeting.book_cover_url ? ' admin-winner--with-cover' : '' %>">
        <% if (meeting.book_cover_url) { %>
          <div class="admin-winner__cover">
            <div class="book-cover">
              <img src="<%= meeting.book_cover_url %>" alt="<%= meeting.book_title %>" loading="lazy">
            </div>
          </div>
        <% } %>
        <div class="admin-winner__info">
          <span class="t-caption-bold"><%= meeting.status === 'results' ? 'Winner:' : 'Selected Book:' %></span>
          <span class="t-body-bold"><%= meeting.book_title %></span>
          <span class="t-caption text-secondary">by <%= meeting.book_author %></span>
          <% if (meeting.status === 'results' && results && results.rankings.length > 0) { %>
            <span class="t-caption text-secondary">&mdash; <%= results.rankings[0].points %> pts</span>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Meeting details (read-only view) -->
    <div id="meeting-details-view">
      <% if (meeting.meetup_event_url || meeting.meeting_time || meeting.location_text) { %>
        <div class="admin-detail-meta">
          <% if (meeting.location_text) { %>
            <p class="t-caption text-secondary">📍 <%= meeting.location_text %></p>
          <% } %>
          <% if (meeting.meeting_time) { %>
            <p class="t-caption text-secondary">🕐 <%= formatMeetingTime(meeting.meeting_time) %></p>
          <% } %>
          <% if (meeting.meetup_event_url) { %>
            <p class="t-caption"><a href="<%= meeting.meetup_event_url %>" target="_blank" rel="noopener">Meetup Event &rarr;</a></p>
          <% } %>
        </div>
      <% } else { %>
        <p class="t-caption text-secondary" style="margin-top: var(--s-2);">No event details set. Click "Edit Details" to add.</p>
      <% } %>
    </div>

    <!-- Event details (edit form, animated reveal) -->
    <div id="meeting-details-edit" class="admin-edit-reveal">
      <form id="edit-meeting-form" class="admin-form" data-meeting-id="<%= meeting.id %>">
        <label class="form-label">
          Pick Month
          <input type="month" name="month_year" class="form-input"
                 value="<%= meeting.month_year %>">
        </label>

        <label class="form-label">
          Meetup Event URL <span class="text-secondary">(optional)</span>
          <input type="url" name="meetup_event_url" class="form-input"
                 value="<%= meeting.meetup_event_url || '' %>"
                 placeholder="https://www.meetup.com/...">
        </label>

        <label class="form-label">
          Event Date &amp; Time <span class="text-secondary">(optional)</span>
          <input type="datetime-local" name="meeting_time" class="form-input"
                 value="<%= meeting.meeting_time || '' %>">
        </label>

        <label class="form-label">
          Location <span class="text-secondary">(optional)</span>
          <input type="text" name="location_text" class="form-input"
                 value="<%= meeting.location_text || '' %>"
                 placeholder="e.g. The Interval, San Francisco">
        </label>

        <div id="edit-message" hidden></div>

        <div style="display: flex; gap: var(--s-2);">
          <button type="submit" class="btn btn--primary btn--sm" id="edit-submit">Save Changes</button>
          <button type="button" class="btn btn--secondary btn--sm" id="cancel-edit-btn">Cancel</button>
        </div>
      </form>
    </div>

    <!-- Nominees -->
    <h2 class="t-body-bold admin-page__subheading">
      Nominees (<%= nominees.length %>)
    </h2>

    <div class="admin-nominees">
      <% if (nominees.length > 0) { %>
        <% nominees.forEach(function(nom) { %>
          <div class="admin-nominee" data-book-id="<%= nom.book_id %>">
            <% if (nom.cover_url) { %>
              <div class="book-cover book-cover--xs">
                <img src="<%= nom.cover_url %>" alt="<%= nom.title %>" loading="lazy">
              </div>
            <% } %>
            <div class="admin-nominee__info js-nominee-display" data-book-id="<%= nom.book_id %>">
              <span class="t-body js-nominee-title"><%= nom.title %></span>
              <span class="t-caption text-secondary js-nominee-author"><%= nom.author %></span>
              <span class="t-caption text-secondary" style="opacity: 0.5;">
                <% if (nom.nominator_name) { %>
                  Nominated by <%= nom.nominator_name %>
                <% } else { %>
                  <%= nom.source %>
                <% } %>
              </span>
              <% if (nom.reason) { %>
                <p class="t-caption text-secondary js-nominee-reason" style="margin-top: var(--s-1); font-style: italic;">&ldquo;<%= nom.reason %>&rdquo;</p>
              <% } %>
            </div>
            <div class="admin-nominee-edit" data-book-id="<%= nom.book_id %>" hidden>
              <input type="text" class="form-input form-input--sm" name="title" value="<%= nom.title %>" placeholder="Title">
              <input type="text" class="form-input form-input--sm" name="author" value="<%= nom.author %>" placeholder="Author">
              <div style="display: flex; gap: var(--s-2);">
                <button type="button" class="btn btn--primary btn--xs js-save-nominee"
                        data-meeting-id="<%= meeting.id %>"
                        data-book-id="<%= nom.book_id %>">Save</button>
                <button type="button" class="btn btn--ghost btn--xs js-cancel-edit-nominee">Cancel</button>
              </div>
            </div>
            <div class="admin-nominee__actions">
              <button type="button" class="btn btn--ghost btn--xs js-edit-nominee" data-book-id="<%= nom.book_id %>">Edit</button>
              <% if (meeting.status !== 'results' && meeting.status !== 'upcoming' && meeting.status !== 'reading' && meeting.status !== 'scheduled') { %>
                <button class="btn btn--danger btn--sm js-remove-nominee"
                        data-meeting-id="<%= meeting.id %>"
                        data-book-id="<%= nom.book_id %>"
                        data-title="<%= nom.title %>">Remove</button>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="t-body text-secondary">No nominees yet.</p>
      <% } %>
    </div>

    <!-- Add nominee (only during nominations) -->
    <% if (meeting.status === 'nominations') { %>
      <h2 class="t-body-bold admin-page__subheading">Add Nominee</h2>
      <form id="add-nominee-form" class="admin-nominee-form"
            data-meeting-id="<%= meeting.id %>">
        <input type="text" name="title" class="form-input" placeholder="Book title" required>
        <input type="text" name="author" class="form-input" placeholder="Author name" required>
        <button type="submit" class="btn btn--secondary btn--sm" id="add-nominee-submit">Add</button>
      </form>
      <div id="nominee-message" hidden></div>
    <% } %>

    <!-- Results table -->
    <% if (results && results.rankings.length > 0) { %>
      <h2 class="t-body-bold admin-page__subheading">Results</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th class="t-caption">Rank</th>
            <th class="t-caption">Title</th>
            <th class="t-caption">Author</th>
            <th class="t-caption" style="text-align: right;">Points</th>
          </tr>
        </thead>
        <tbody>
          <% results.rankings.forEach(function(r) { %>
            <tr>
              <td class="t-body"><%= r.rank %></td>
              <td class="t-body"><%= r.title %></td>
              <td class="t-body text-secondary"><%= r.author %></td>
              <td class="t-body" style="text-align: right;"><%= r.points %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <!-- Super-admin: Delete Meeting -->
    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
      <div class="admin-danger-zone">
        <h2 class="t-body-bold admin-page__subheading">Danger Zone</h2>
        <p class="t-caption text-secondary" style="margin-bottom: var(--s-2);">
          Permanently delete this pick and all associated nominations, votes, and results.
        </p>
        <button type="button"
                class="btn btn--danger btn--sm"
                id="delete-meeting-btn"
                data-meeting-id="<%= meeting.id %>"
                data-meeting-label="<%= formatMonthYear(meeting.month_year) %>">
          Delete Pick
        </button>
      </div>
    <% } %>
  <% } %>
</section>

<% if (meeting) { %>
<script>
  window.__MEETING_CONFIG__ = {
    meetingId: <%= meeting.id %>,
    status: '<%= meeting.status %>'
  };
</script>
<% } %>
