<section class="admin-page">
  <div class="admin-page__header-row">
    <h1 class="t-section admin-page__heading"><%= pageTitle %></h1>
    <a href="/admin/picks/new" class="btn btn--primary btn--sm">+ New Pick</a>
  </div>

  <!-- Stats row -->
  <div class="admin-stats">
    <div class="admin-stat-card">
      <span class="admin-stat-card__value"><%= stats.totalBooks %></span>
      <span class="admin-stat-card__label">Books</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-card__value"><%= stats.totalMembers %></span>
      <span class="admin-stat-card__label">Members</span>
    </div>
    <div class="admin-stat-card">
      <span class="admin-stat-card__value"><%= stats.totalReviews %></span>
      <span class="admin-stat-card__label">Reviews</span>
    </div>
  </div>

  <!-- Current pick -->
  <h2 class="t-body-bold admin-page__subheading">Current Pick</h2>

  <% if (current) { %>
    <div class="admin-meeting-card<%= current.book_cover_url ? ' admin-meeting-card--with-cover' : '' %>">
      <% if (current.book_cover_url) { %>
        <div class="admin-meeting-card__cover">
          <div class="book-cover">
            <img src="<%= current.book_cover_url %>" alt="<%= current.book_title %>" loading="lazy">
          </div>
        </div>
      <% } %>
      <div class="admin-meeting-card__content">
        <div class="admin-meeting-card__header">
          <span class="t-body-bold"><%= formatMonthYear(current.month_year) %></span>
          <span class="status-pill status-pill--<%= current.status %>"><%= formatStatus(current.status) %></span>
        </div>

        <div class="admin-meeting-card__body">
          <p class="t-caption text-secondary">
            <% if (current.book_title) { %>
              <strong><%= current.book_title %></strong> &middot;
            <% } %>
            <%= nominees.length %> nominee<%= nominees.length === 1 ? '' : 's' %>
            &middot; <%= voteCount %> vote<%= voteCount === 1 ? '' : 's' %>
          </p>
        </div>

        <div class="admin-meeting-card__actions">
          <a href="/admin/picks/<%= monthYearSlug(current.month_year) %>" class="btn btn--primary btn--sm">Manage</a>

          <% if (current.status === 'reading') { %>
            <button class="btn btn--secondary btn--sm js-advance-status"
                    data-meeting-id="<%= current.id %>"
                    data-new-status="results">Close Pick</button>
          <% } else if (current.status === 'nominations') { %>
            <button class="btn btn--secondary btn--sm js-advance-status"
                    data-meeting-id="<%= current.id %>"
                    data-new-status="voting">Start Voting</button>
          <% } else if (current.status === 'voting') { %>
            <button class="btn btn--secondary btn--sm js-advance-status"
                    data-meeting-id="<%= current.id %>"
                    data-new-status="results">Finalize Results</button>
          <% } %>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="admin-empty">
      <p class="t-body text-secondary">No active pick. Create one or open nominations on an upcoming pick.</p>
    </div>
  <% } %>

  <%- include('../partials/qr-panel') %>

  <% if (results && results.rankings.length > 0) { %>
    <h2 class="t-body-bold admin-page__subheading">Current Results</h2>
    <table class="admin-table">
      <thead>
        <tr>
          <th class="t-caption">Rank</th>
          <th class="t-caption">Title</th>
          <th class="t-caption">Author</th>
          <th class="t-caption" style="text-align: right;">Points</th>
        </tr>
      </thead>
      <tbody>
        <% results.rankings.forEach(function(r) { %>
          <tr>
            <td class="t-body"><%= r.rank %></td>
            <td class="t-body"><%= r.title %></td>
            <td class="t-body text-secondary"><%= r.author %></td>
            <td class="t-body" style="text-align: right;"><%= r.points %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <!-- Upcoming picks -->
  <% if (upcoming.length > 0) { %>
    <h2 class="t-body-bold admin-page__subheading">Upcoming Picks</h2>

    <% upcoming.forEach(function(m) { %>
      <div class="admin-meeting-card<%= m.book_cover_url ? ' admin-meeting-card--with-cover' : '' %>">
        <% if (m.book_cover_url) { %>
          <div class="admin-meeting-card__cover">
            <div class="book-cover">
              <img src="<%= m.book_cover_url %>" alt="<%= m.book_title %>" loading="lazy">
            </div>
          </div>
        <% } %>
        <div class="admin-meeting-card__content">
          <div class="admin-meeting-card__header">
            <span class="t-body-bold"><%= formatMonthYear(m.month_year) %></span>
            <span class="status-pill status-pill--upcoming"><%= formatStatus(m.status) %></span>
          </div>
          <% if (m.book_title) { %>
            <div class="admin-meeting-card__body">
              <p class="t-caption text-secondary"><strong><%= m.book_title %></strong> by <%= m.book_author %></p>
            </div>
          <% } %>
          <div class="admin-meeting-card__actions">
            <a href="/admin/picks/<%= monthYearSlug(m.month_year) %>" class="btn btn--primary btn--sm">Manage</a>
            <% if (m.winning_book_id) { %>
              <button class="btn btn--secondary btn--sm js-advance-status"
                      data-meeting-id="<%= m.id %>"
                      data-new-status="reading">Mark as Reading</button>
            <% } else { %>
              <button class="btn btn--secondary btn--sm js-advance-status"
                      data-meeting-id="<%= m.id %>"
                      data-new-status="nominations">Open Nominations</button>
            <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  <% } %>
</section>

<script>
(function () {
  'use strict';
  document.querySelectorAll('.js-advance-status').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var meetingId = btn.dataset.meetingId;
      var newStatus = btn.dataset.newStatus;
      var labels = {
        reading: 'mark as reading',
        nominations: 'open nominations',
        voting: 'start voting',
        results: 'finalize results',
      };
      if (!confirm('Are you sure you want to ' + (labels[newStatus] || newStatus) + '?')) return;

      btn.disabled = true;
      btn.textContent = 'Updating\u2026';

      try {
        var res = await fetch('/api/admin/meetings/' + meetingId + '/status', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ status: newStatus }),
        });
        var data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Something went wrong.');
          btn.disabled = false;
          var labelMap = { reading: 'Mark as Reading', nominations: 'Open Nominations', voting: 'Start Voting', results: 'Finalize Results' };
          btn.textContent = labelMap[btn.dataset.newStatus] || btn.dataset.newStatus;
        }
      } catch (err) {
        alert('Network error.');
        btn.disabled = false;
      }
    });
  });
})();
</script>
