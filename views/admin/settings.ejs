<section class="admin-page">
  <h1 class="t-section admin-page__heading"><%= pageTitle %></h1>

  <!-- Account info -->
  <div class="admin-settings-card">
    <h2 class="t-body-bold">Your Account</h2>
    <p class="t-body"><%= user.email %></p>

    <form id="display-name-form" class="admin-form admin-form--inline" style="margin-top: var(--s-2);">
      <label class="visually-hidden" for="display-name-input">Display Name</label>
      <input type="text" id="display-name-input" name="display_name" class="form-input"
             value="<%= user.display_name || '' %>"
             placeholder="Display Name" maxlength="40" required>
      <button type="submit" class="btn btn--secondary btn--sm" id="display-name-submit">Save</button>
    </form>
    <div id="display-name-message" role="alert" hidden></div>
  </div>

  <!-- Admin accounts -->
  <div class="admin-settings-card">
    <h2 class="t-body-bold">Admin Accounts</h2>
    <div class="admin-user-list">
      <% for (const admin of admins) { %>
        <div class="admin-user-row">
          <div>
            <span class="t-body"><%= admin.email %></span>
            <% if (admin.display_name) { %>
              <span class="t-caption text-secondary">&middot; <%= admin.display_name %></span>
            <% } %>
          </div>
          <% if (admin.id === user.id) { %>
            <span class="t-caption text-secondary">(you)</span>
          <% } %>
        </div>
      <% } %>
    </div>

    <h3 class="t-caption-bold" style="margin-top: var(--s-4);">Add Admin</h3>
    <form id="add-admin-form" class="admin-form admin-form--inline" style="margin-top: var(--s-2);">
      <label class="visually-hidden" for="add-admin-email">Email</label>
      <input type="email" id="add-admin-email" name="email" class="form-input" placeholder="Email" required>
      <div class="password-wrapper">
        <label class="visually-hidden" for="add-admin-password">Password (8+ characters)</label>
        <input type="password" id="add-admin-password" name="password" class="form-input" placeholder="Password (8+ chars)" required minlength="8">
        <button type="button" class="password-toggle" aria-label="Show password">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line class="pw-slash" x1="2" y1="2" x2="22" y2="22"/></svg>
        </button>
      </div>
      <button type="submit" class="btn btn--secondary btn--sm" id="add-admin-submit">Add</button>
    </form>
    <div id="admin-user-message" role="alert" hidden></div>
  </div>

  <!-- Library -->
  <div class="admin-settings-card">
    <h2 class="t-body-bold">Library</h2>
    <form id="library-form" class="admin-form" style="margin-top: var(--s-2);">
      <label class="form-label">
        Library Catalog URL
        <input type="url" name="library_url" class="form-input"
               value="<%= libraryUrl || '' %>"
               placeholder="https://sfpl.org/search?q=">
        <span class="t-caption text-tertiary">Search URL for your local library. The book title will be appended.</span>
      </label>
      <button type="submit" class="btn btn--secondary btn--sm" id="library-submit">Save</button>
    </form>
    <div id="library-message" role="alert" hidden></div>
  </div>

  <!-- Links -->
  <div class="admin-settings-card">
    <h2 class="t-body-bold">Links</h2>
    <p><a href="/" class="t-body" style="color: var(--accent);">View public site &rarr;</a></p>
  </div>

  <!-- Logout -->
  <div class="admin-settings-card">
    <button id="admin-logout-btn" class="btn btn--danger btn--sm">Log Out</button>
  </div>
</section>

<script>
(function () {
  'use strict';

  // Logout
  var logoutBtn = document.getElementById('admin-logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async function () {
      logoutBtn.disabled = true;
      logoutBtn.textContent = 'Logging out\u2026';
      try {
        var res = await fetch('/api/auth/admin-logout', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
        });
        var data = await res.json();
        window.location.href = data.redirect || '/admin/login';
      } catch (err) {
        window.location.href = '/admin/login';
      }
    });
  }

  // Display name
  var dnForm = document.getElementById('display-name-form');
  var dnMsg = document.getElementById('display-name-message');
  if (dnForm) {
    dnForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var name = dnForm.querySelector('[name="display_name"]').value.trim();
      if (!name) return;
      var btn = document.getElementById('display-name-submit');
      btn.disabled = true;
      btn.textContent = 'Saving\u2026';
      try {
        var res = await fetch('/api/auth/display-name', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ display_name: name }),
        });
        var data = await res.json();
        if (res.ok && data.success) {
          dnMsg.hidden = false;
          dnMsg.className = 'nom-message nom-message--success';
          dnMsg.textContent = 'Display name updated.';
          setTimeout(function () { dnMsg.hidden = true; }, 2000);
        } else {
          dnMsg.hidden = false;
          dnMsg.className = 'nom-message nom-message--error';
          dnMsg.textContent = data.error || 'Something went wrong.';
        }
      } catch (err) {
        dnMsg.hidden = false;
        dnMsg.className = 'nom-message nom-message--error';
        dnMsg.textContent = 'Network error.';
      }
      btn.disabled = false;
      btn.textContent = 'Save';
    });
  }

  // Add admin
  var form = document.getElementById('add-admin-form');
  var msg = document.getElementById('admin-user-message');
  if (!form) return;

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    var email = form.querySelector('[name="email"]').value.trim();
    var password = form.querySelector('[name="password"]').value;
    if (!email || !password) return;

    var btn = document.getElementById('add-admin-submit');
    btn.disabled = true;
    btn.textContent = 'Adding\u2026';

    try {
      var res = await fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ email: email, password: password }),
      });
      var data = await res.json();

      if (res.ok && data.success) {
        window.location.reload();
        return;
      }

      msg.hidden = false;
      msg.className = 'nom-message nom-message--error';
      msg.textContent = data.error || 'Something went wrong.';
    } catch (err) {
      msg.hidden = false;
      msg.className = 'nom-message nom-message--error';
      msg.textContent = 'Network error.';
    }

    btn.disabled = false;
    btn.textContent = 'Add';
  });

  // Library URL
  var libForm = document.getElementById('library-form');
  var libMsg = document.getElementById('library-message');
  if (libForm) {
    libForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var libBtn = document.getElementById('library-submit');
      libBtn.disabled = true;
      libBtn.textContent = 'Saving\u2026';
      try {
        var res = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ library_url: libForm.querySelector('[name="library_url"]').value.trim() }),
        });
        var data = await res.json();
        if (res.ok && data.success) {
          libMsg.hidden = false;
          libMsg.className = 'nom-message nom-message--success';
          libMsg.textContent = 'Library URL saved.';
          setTimeout(function () { libMsg.hidden = true; }, 2000);
        } else {
          libMsg.hidden = false;
          libMsg.className = 'nom-message nom-message--error';
          libMsg.textContent = data.error || 'Something went wrong.';
        }
      } catch (err) {
        libMsg.hidden = false;
        libMsg.className = 'nom-message nom-message--error';
        libMsg.textContent = 'Network error.';
      }
      libBtn.disabled = false;
      libBtn.textContent = 'Save';
    });
  }

  // Password visibility toggle
  document.querySelectorAll('.password-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var input = btn.parentElement.querySelector('input');
      var show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.classList.toggle('is-visible', show);
      btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    });
  });
})();
</script>
