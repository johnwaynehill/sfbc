<section class="vote-page">
  <header class="vote-page__header">
    <h1 class="t-section vote-page__heading"><%= pageTitle %></h1>
    <p class="t-body text-secondary">for <%= formatMonthYear(meeting.month_year) %></p>
    <p class="t-caption text-secondary vote-page__count">
      <span id="vote-count"><%= voteCount %></span> vote<%= voteCount === 1 ? '' : 's' %> counted
    </p>
    <% if (user) { %>
      <p class="t-caption text-secondary">Voting as <strong><%= user.display_name %></strong></p>
    <% } %>
  </header>

  <%- include('partials/meeting-details-bar', { barMeeting: barMeeting }) %>

  <p class="t-body vote-page__instructions">
    Rank the books from <strong>most</strong> to <strong>least</strong> wanted.
    Your top pick gets the most points.
  </p>

  <form id="vote-form"
        class="vote-form"
        method="POST"
        action="/api/meetings/<%= meeting.id %>/votes"
        data-meeting-id="<%= meeting.id %>"
        data-meeting-slug="<%= meetingSlug %>">

    <ol id="ballot-list" class="ballot-list">
      <% nominees.forEach(function(nom, i) { %>
        <li class="ballot-card" data-book-id="<%= nom.book_id %>" draggable="true">
          <span class="ballot-card__rank" aria-label="Rank <%= i + 1 %>"><%= i + 1 %></span>

          <div class="book-cover book-cover--sm ballot-card__cover">
            <% if (nom.cover_url) { %>
              <img src="<%= nom.cover_url %>" alt="<%= nom.title %> cover" loading="lazy">
            <% } else { %>
              <%- include('partials/placeholder-cover', { phTitle: nom.title, phSize: 'sm' }) %>
            <% } %>
          </div>

          <div class="ballot-card__body">
            <span class="ballot-card__title t-body-bold"><%= nom.title %></span>
            <span class="ballot-card__author t-caption text-secondary"><%= nom.author %><% if (nom.publication_year) { %> (<%= nom.publication_year %>)<% } %></span>
            <button type="button" class="ballot-card__details-link t-caption" data-book-id="<%= nom.book_id %>">
              View
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <%
              var subjectList = [];
              if (nom.subjects) {
                try { subjectList = JSON.parse(nom.subjects); } catch (e) { subjectList = []; }
              }
            %>
            <template class="ballot-card__details-template">
              <div class="book-details">
                <div class="book-details__header">
                  <div class="book-cover book-cover--md book-details__cover">
                    <% if (nom.cover_url) { %>
                      <img src="<%= nom.cover_url %>" alt="<%= nom.title %> cover" loading="lazy">
                    <% } else { %>
                      <%- include('partials/placeholder-cover', { phTitle: nom.title, phSize: 'md' }) %>
                    <% } %>
                  </div>
                  <div class="book-details__meta">
                    <h2 class="book-details__title t-display"><%= nom.title %></h2>
                    <p class="book-details__author t-author">by <%= nom.author %></p>
                    <% var metaParts = []; %>
                    <% if (nom.publication_year) metaParts.push(nom.publication_year); %>
                    <% if (nom.page_count) metaParts.push(nom.page_count + ' pages'); %>
                    <% if (nom.publisher) metaParts.push(nom.publisher); %>
                    <% if (nom.language && nom.language !== 'en') metaParts.push(nom.language.toUpperCase()); %>
                    <% if (metaParts.length > 0) { %>
                      <p class="book-details__inline-meta t-caption text-secondary"><%= metaParts.join(' · ') %></p>
                    <% } %>
                    <% if (subjectList.length > 0) { %>
                      <div class="book-details__tags">
                        <% subjectList.slice(0, 4).forEach(function(tag) { %>
                          <span class="book-tag"><%= tag %></span>
                        <% }); %>
                      </div>
                    <% } %>
                  </div>
                </div>

                <% if (nom.description) { %>
                  <div class="book-details__section">
                    <p class="book-details__description t-body"><%= nom.description %></p>
                  </div>
                <% } %>

                <% if (nom.reason || nom.nominator_name) { %>
                  <div class="book-details__section book-details__nomination">
                    <% if (nom.nominator_name) { %>
                      <p class="t-label">Nominated by <%= nom.nominator_name %></p>
                    <% } %>
                    <% if (nom.reason) { %>
                      <p class="book-details__reason t-body">&ldquo;<%= nom.reason %>&rdquo;</p>
                    <% } %>
                  </div>
                <% } %>

                <div class="book-details__footer">
                  <a href="/books/<%= nom.author_slug %>/<%= nom.title_slug %>"
                     target="_blank" rel="noopener" class="book-details__link">
                    View Details
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </div>
              </div>
            </template>
          </div>

          <div class="ballot-card__controls">
            <button type="button" class="ballot-card__move ballot-card__move--up"
                    aria-label="Move up"<%= i === 0 ? ' disabled' : '' %>>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 11V3M3 6l4-4 4 4"/>
              </svg>
            </button>
            <div class="ballot-card__handle" aria-label="Drag to reorder">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <circle cx="5" cy="3" r="1.5"/><circle cx="11" cy="3" r="1.5"/>
                <circle cx="5" cy="8" r="1.5"/><circle cx="11" cy="8" r="1.5"/>
                <circle cx="5" cy="13" r="1.5"/><circle cx="11" cy="13" r="1.5"/>
              </svg>
            </div>
            <button type="button" class="ballot-card__move ballot-card__move--down"
                    aria-label="Move down"<%= i === nominees.length - 1 ? ' disabled' : '' %>>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 3v8M3 8l4 4 4-4"/>
              </svg>
            </button>
          </div>
        </li>
      <% }); %>
    </ol>

    <p class="t-caption text-tertiary ballot-hint ballot-hint--desktop">Drag cards or use the arrows to rank your picks</p>
    <p class="t-caption text-tertiary ballot-hint ballot-hint--mobile">Use the arrows to rank your picks</p>

    <!-- Hidden field keeps ranking in sync for no-JS form POST fallback -->
    <input type="hidden" name="ranking" id="ranking-input"
           value="<%= nominees.map(function(n) { return n.book_id; }).join(',') %>">

    <!-- No-JS fallback: rank select dropdowns -->
    <noscript>
      <div class="vote-nojs-ranks">
        <p class="t-caption text-secondary">Drag &amp; drop requires JavaScript. Use the dropdowns below to set your ranking:</p>
        <% nominees.forEach(function(nom) { %>
          <label class="form-label t-caption">
            <%= nom.title %> &mdash; Rank:
            <select name="rank_<%= nom.book_id %>" class="form-input form-input--sm">
              <% for (var r = 1; r <= nominees.length; r++) { %>
                <option value="<%= r %>"><%= r %></option>
              <% } %>
            </select>
          </label>
        <% }); %>
      </div>
    </noscript>

    <div id="vote-message" hidden></div>

    <button type="submit" class="btn btn--primary vote-form__submit" id="vote-submit">
      Submit Vote
    </button>
  </form>

  <dialog id="book-details-dialog" class="book-details-dialog" aria-labelledby="book-details-dialog-title">
    <button type="button" class="book-details-dialog__close" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="book-details-dialog__body" id="book-details-dialog-body"></div>
  </dialog>
</section>
