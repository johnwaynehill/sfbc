<section class="member-profile">

  <!-- ===== Hero ===== -->
  <div class="member-profile__hero">
    <%- include('partials/avatar', { avatarUser: member, avatarSize: 'lg', avatarClass: '' }) %>
    <div class="member-profile__hero-body">
      <h1 class="t-section"><%= member.display_name || 'Anonymous' %></h1>
      <p class="t-body text-secondary">
        Member since <%= new Date(member.created_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %>
      </p>
    </div>
  </div>

  <!-- ===== Reading Stats ===== -->
  <% if (stats.review_count > 0) { %>
  <div class="member-profile__stats">
    <div class="member-stat">
      <span class="member-stat__value"><%= stats.review_count %></span>
      <span class="member-stat__label">Book<%= stats.review_count !== 1 ? 's' : '' %> Reviewed</span>
    </div>
    <% if (stats.avgGrade) { %>
    <div class="member-stat">
      <span class="grade-badge grade-badge--sm <%= gradeTier(stats.avgGrade) %>"><%= stats.avgGrade %></span>
      <span class="member-stat__label">Avg Grade</span>
    </div>
    <% } %>
  </div>
  <% } %>

  <!-- ===== Social Links ===== -->
  <% var hasSocial = member.goodreads_url || member.storygraph_url || member.instagram_handle || member.threads_handle; %>
  <% if (hasSocial) { %>
  <div class="member-profile__social">
    <h2 class="t-body-bold member-profile__section-title">Reading Profiles</h2>
    <div class="member-social-links">
      <% if (member.goodreads_url) { %>
        <a href="<%= member.goodreads_url %>" class="member-social-link" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.43 23.995c-3.608-.208-6.274-2.077-7.628-5.08-.358-.795-.573-1.665-.696-2.588l.003-.042c1.32 2.988 3.397 4.457 6.577 4.905 2.628.37 4.834-.396 6.62-2.283.307-.325.566-.696.9-1.107v2.56c0 1.167-.2 2.264-.823 3.268-.815 1.314-2.064 2.07-3.538 2.346-.483.084-.98.112-1.415.02zm7.12-10.003v1.345h-.063c-.527 1.03-1.3 1.81-2.39 2.217-.97.362-1.985.433-3.018.266-2.724-.44-4.632-2.903-4.423-5.715.236-3.17 2.36-5.265 5.167-5.233 1.094.013 2.095.376 2.963 1.07.114.091.226.186.39.32V2h1.374v11.992zm-1.39-2.818c-.04-2.497-1.845-4.452-4.185-4.476-2.408-.024-4.326 1.974-4.34 4.518-.014 2.475 1.808 4.434 4.15 4.476 2.48.044 4.38-1.898 4.376-4.518z"/></svg>
          Goodreads
        </a>
      <% } %>
      <% if (member.storygraph_url) { %>
        <a href="<%= member.storygraph_url %>" class="member-social-link" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          StoryGraph
        </a>
      <% } %>
      <% if (member.instagram_handle) { %>
        <a href="https://instagram.com/<%= member.instagram_handle %>" class="member-social-link" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          @<%= member.instagram_handle %>
        </a>
      <% } %>
      <% if (member.threads_handle) { %>
        <a href="https://threads.net/@<%= member.threads_handle %>" class="member-social-link" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.59 12c.025 3.086.718 5.496 2.057 7.164 1.432 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.34-.775-.951-1.4-1.762-1.81-.4 2.51-1.199 4.396-2.453 5.402-1.023.822-2.31 1.178-3.628 1.005-1.1-.144-2.078-.616-2.753-1.328-.752-.793-1.13-1.855-1.063-2.996.115-1.94 1.614-3.486 3.634-3.747.972-.126 1.873-.042 2.685.26l.008-.464c-.011-1.038-.112-1.972-.685-2.607-.516-.571-1.31-.86-2.362-.86h-.045c-.853.01-1.558.272-2.04.76l-1.39-1.472c.777-.737 1.835-1.134 3.07-1.166h.067c1.542 0 2.724.486 3.514 1.444.7.848.999 1.956 1.08 3.22l.003.049c.968.396 1.776.97 2.362 1.69.965 1.18 1.36 2.667 1.144 4.305-.295 2.227-1.283 3.939-2.94 5.09-1.41.977-3.22 1.49-5.394 1.522z"/></svg>
          @<%= member.threads_handle %>
        </a>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ===== Reviews ===== -->
  <div class="member-profile__reviews">
    <h2 class="t-section member-profile__section-title">Reviews</h2>
    <% if (reviews.length > 0) { %>
      <div class="member-review-list">
        <% for (const review of reviews) { %>
          <div class="member-review-card">
            <span class="grade-badge grade-badge--sm <%= gradeTier(review.grade) %>"><%= review.grade %></span>
            <div class="member-review-card__body">
              <a href="<%= bookPath(review.title, review.author) %>" class="member-review-card__book">
                <strong class="t-body-bold"><%= review.title %></strong>
                <span class="t-caption text-secondary" style="font-style: italic;">by <%= review.author %></span>
              </a>
              <% if (review.body_markdown) { %>
                <div class="member-review-card__text t-body"><%- renderMarkdown(review.body_markdown) %></div>
              <% } %>
              <span class="t-caption text-tertiary">
                <%= new Date(review.created_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </span>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="t-body text-secondary" style="margin-top: var(--s-3);">No reviews yet.</p>
    <% } %>
  </div>

</section>
