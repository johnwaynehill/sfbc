<section class="nominations-page">
  <header class="nominations-page__header">
    <h1 class="t-section nominations-page__heading"><%= pageTitle %></h1>
    <p class="t-body text-secondary">for <%= formatMonthYear(meeting.month_year) %></p>
    <% if (meeting.topic) { %>
      <p class="nom-topic t-label"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg> Theme: <%= meeting.topic %></p>
    <% } %>
    <p class="t-caption text-secondary nominations-page__count">
      <span id="nominee-count"><%= nominees.length %></span> nomination<%= nominees.length === 1 ? '' : 's' %> so far
    </p>
  </header>

  <%- include('partials/meeting-details-bar', { barMeeting: barMeeting }) %>

  <div class="nominations-page__actions">
    <a href="/nominate/<%= meetingSlug %>" class="btn btn--primary btn--sm">
      Nominate a Book
    </a>
  </div>

  <div class="nominee-grid" id="nominee-grid">
    <% if (nominees.length === 0) { %>
      <p class="t-body text-secondary nominations-page__empty" id="nominee-empty">
        No nominations yet &mdash; be the first!
      </p>
    <% } %>
    <% nominees.forEach(function(nom) { %>
      <div class="nominee-card" data-book-id="<%= nom.book_id %>">
        <div class="book-cover book-cover--sm nominee-card__cover">
          <% if (nom.cover_url) { %>
            <img src="<%= nom.cover_url %>" alt="<%= nom.title %> cover" loading="lazy">
          <% } else { %>
            <%- include('partials/placeholder-cover', { phTitle: nom.title, phSize: 'sm' }) %>
          <% } %>
        </div>
        <div class="nominee-card__body">
          <span class="nominee-card__title t-body-bold"><%= nom.title %></span>
          <span class="nominee-card__author t-caption text-secondary"><%= nom.author %></span>
          <% if (nom.nominator_name) { %>
            <span class="nominee-card__nominator t-caption text-tertiary">Nominated by <%= nom.nominator_name %></span>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<script>
  window.__NOMINATIONS_CONFIG__ = {
    meetingId: <%= meeting.id %>,
  };
</script>
